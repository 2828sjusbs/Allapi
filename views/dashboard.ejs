<!DOCTYPE html>
<html lang="en" class="dark">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>OSINT API Hub - Admin Dashboard</title>
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- FontAwesome Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&family=JetBrains+Mono:wght@400;500;700&display=swap" rel="stylesheet">
    <script>
        tailwind.config = {
            darkMode: 'class',
            theme: {
                extend: {
                    colors: {
                        brand: {
                            50: '#eef2ff',
                            500: '#6366f1',
                            600: '#4f46e5',
                            700: '#4338ca',
                            cyan: '#06b6d4',
                            emerald: '#10b981',
                            rose: '#f43f5e',
                            dark: '#0B0F19',
                            card: '#111827',
                            border: '#1F2937'
                        }
                    },
                    fontFamily: {
                        sans: ['Plus Jakarta Sans', 'sans-serif'],
                        mono: ['JetBrains Mono', 'monospace']
                    }
                }
            }
        }
    </script>
    <style>
        body { background-color: #0B0F19; color: #F3F4F6; }
        .glass-card {
            background: rgba(17, 24, 39, 0.7);
            backdrop-filter: blur(12px);
            border: 1px solid rgba(255, 255, 255, 0.08);
        }
        .glow-cyan { box-shadow: 0 0 20px rgba(6, 182, 212, 0.15); }
        .glow-indigo { box-shadow: 0 0 20px rgba(99, 102, 241, 0.15); }
        .custom-scrollbar::-webkit-scrollbar { width: 6px; height: 6px; }
        .custom-scrollbar::-webkit-scrollbar-track { background: #0B0F19; }
        .custom-scrollbar::-webkit-scrollbar-thumb { background: #1F2937; border-radius: 4px; }
        .custom-scrollbar::-webkit-scrollbar-thumb:hover { background: #374151; }
    </style>
</head>
<body class="font-sans antialiased custom-scrollbar min-h-screen flex flex-col justify-between">

    <!-- Navbar -->
    <nav class="sticky top-0 z-40 border-b border-gray-800/80 bg-brand-dark/90 backdrop-blur-md">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="flex items-center justify-between h-16">
                <div class="flex items-center gap-3">
                    <div class="h-10 w-10 rounded-xl bg-gradient-to-tr from-brand-600 to-brand-cyan flex items-center justify-center shadow-lg shadow-brand-500/20">
                        <i class="fa-solid fa-terminal text-white text-lg"></i>
                    </div>
                    <div>
                        <span class="text-xl font-extrabold tracking-tight bg-clip-text text-transparent bg-gradient-to-r from-white via-gray-200 to-gray-400">OSINT <span class="text-brand-cyan">HUB</span></span>
                        <span class="block text-[10px] font-mono text-gray-400 uppercase tracking-widest">Admin Control Panel</span>
                    </div>
                </div>
                <div class="flex items-center gap-4">
                    <div class="hidden md:flex items-center gap-2 px-3 py-1.5 rounded-full bg-gray-900 border border-gray-800 text-xs">
                        <span class="relative flex h-2 w-2">
                          <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-brand-emerald opacity-75"></span>
                          <span class="relative inline-flex rounded-full h-2 w-2 bg-brand-emerald"></span>
                        </span>
                        <span class="text-gray-300 font-mono"><%= user ? user.username : 'Admin' %></span>
                        <span class="text-xs px-2 py-0.5 rounded bg-brand-600/30 text-brand-500 font-semibold border border-brand-500/30 uppercase"><%= user ? user.role : 'Admin' %></span>
                    </div>
                    <a href="/logout" class="px-3.5 py-2 rounded-lg bg-red-500/10 hover:bg-red-500/20 text-red-400 text-xs font-medium border border-red-500/20 transition flex items-center gap-2">
                        <i class="fa-solid fa-right-from-bracket"></i> Logout
                    </a>
                </div>
            </div>
        </div>
    </nav>

    <!-- Main Content -->
    <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 w-full mb-auto">

        <!-- Stats Grid -->
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5 mb-8">
            <div class="glass-card rounded-2xl p-5 glow-indigo relative overflow-hidden">
                <div class="flex items-center justify-between">
                    <div>
                        <p class="text-xs font-medium text-gray-400 uppercase tracking-wider">Total API Keys</p>
                        <h3 class="text-3xl font-extrabold mt-1 text-white font-mono"><%= keys.length %></h3>
                    </div>
                    <div class="p-3 bg-brand-500/10 border border-brand-500/20 text-brand-500 rounded-xl">
                        <i class="fa-solid fa-key text-xl"></i>
                    </div>
                </div>
                <div class="mt-4 text-xs text-gray-400">Registered system access keys</div>
            </div>

            <div class="glass-card rounded-2xl p-5 glow-cyan relative overflow-hidden">
                <div class="flex items-center justify-between">
                    <div>
                        <p class="text-xs font-medium text-gray-400 uppercase tracking-wider">Active Keys</p>
                        <h3 class="text-3xl font-extrabold mt-1 text-emerald-400 font-mono"><%= active %></h3>
                    </div>
                    <div class="p-3 bg-emerald-500/10 border border-emerald-500/20 text-emerald-400 rounded-xl">
                        <i class="fa-solid fa-shield-check text-xl"></i>
                    </div>
                </div>
                <div class="mt-4 text-xs text-emerald-400/80">
                    <i class="fa-solid fa-arrow-up text-[10px] mr-1"></i> Ready for execution
                </div>
            </div>

            <div class="glass-card rounded-2xl p-5 relative overflow-hidden">
                <div class="flex items-center justify-between">
                    <div>
                        <p class="text-xs font-medium text-gray-400 uppercase tracking-wider">Total Requests (Hits)</p>
                        <h3 class="text-3xl font-extrabold mt-1 text-brand-cyan font-mono"><%= totalHits %></h3>
                    </div>
                    <div class="p-3 bg-cyan-500/10 border border-cyan-500/20 text-brand-cyan rounded-xl">
                        <i class="fa-solid fa-chart-network text-xl"></i>
                    </div>
                </div>
                <div class="mt-4 text-xs text-gray-400">Cumulative API call count</div>
            </div>

            <div class="glass-card rounded-2xl p-5 relative overflow-hidden">
                <div class="flex items-center justify-between">
                    <div>
                        <p class="text-xs font-medium text-gray-400 uppercase tracking-wider">Available Endpoints</p>
                        <h3 class="text-3xl font-extrabold mt-1 text-purple-400 font-mono"><%= apis.length %></h3>
                    </div>
                    <div class="p-3 bg-purple-500/10 border border-purple-500/20 text-purple-400 rounded-xl">
                        <i class="fa-solid fa-cubes text-xl"></i>
                    </div>
                </div>
                <div class="mt-4 text-xs text-gray-400">Active server modules</div>
            </div>
        </div>

        <!-- System Message & Quick Action Bar -->
        <div class="glass-card rounded-2xl p-6 mb-8">
            <div class="flex flex-col lg:flex-row lg:items-center justify-between gap-6">
                <div class="flex-1">
                    <div class="flex items-center gap-2 mb-2">
                        <i class="fa-solid fa-bullhorn text-amber-400 text-sm"></i>
                        <h4 class="text-sm font-semibold text-gray-200 uppercase tracking-wider">System Maintenance Banner</h4>
                    </div>
                    <form action="/admin/update-settings" method="POST" class="flex flex-col sm:flex-row gap-3">
                        <input type="text" name="maintenance_message" value="<%= settings.maintenance_message %>" placeholder="Enter maintenance banner message..." 
                            class="flex-1 bg-gray-900 border border-gray-800 rounded-xl px-4 py-2.5 text-sm text-gray-200 focus:outline-none focus:border-brand-500 transition">
                        <button type="submit" class="px-5 py-2.5 bg-brand-600 hover:bg-brand-700 text-white rounded-xl text-sm font-medium transition flex items-center justify-center gap-2 shadow-lg shadow-brand-600/20">
                            <i class="fa-solid fa-floppy-disk"></i> Save Notice
                        </button>
                    </form>
                </div>
                <div class="flex items-end">
                    <button onclick="openModal('generateModal')" class="w-full sm:w-auto px-6 py-3 bg-gradient-to-r from-brand-cyan to-brand-500 hover:from-cyan-500 hover:to-brand-600 text-white font-semibold rounded-xl text-sm shadow-lg shadow-cyan-500/20 transition flex items-center justify-center gap-2">
                        <i class="fa-solid fa-plus-hexagon text-base"></i> Generate New Key
                    </button>
                </div>
            </div>
        </div>

        <!-- Keys Management Table -->
        <div class="glass-card rounded-2xl overflow-hidden border border-gray-800">
            <!-- Table Header Controls -->
            <div class="p-5 border-b border-gray-800/80 flex flex-col md:flex-row md:items-center justify-between gap-4 bg-gray-900/40">
                <div class="flex items-center gap-3">
                    <h2 class="text-lg font-bold text-white tracking-wide">API Access Keys</h2>
                    <span class="text-xs font-mono bg-gray-800 border border-gray-700 text-gray-300 px-2.5 py-1 rounded-full"><%= keys.length %> Total</span>
                </div>
                <div class="flex flex-col sm:flex-row items-center gap-3">
                    <div class="relative w-full sm:w-64">
                        <i class="fa-solid fa-magnifying-glass absolute left-3.5 top-3 text-xs text-gray-500"></i>
                        <input type="text" id="searchInput" onkeyup="filterKeys()" placeholder="Search key, name..." 
                            class="w-full bg-gray-900/80 border border-gray-800 rounded-xl pl-9 pr-4 py-2 text-xs text-gray-200 placeholder-gray-500 focus:outline-none focus:border-brand-500 transition">
                    </div>
                </div>
            </div>

            <!-- Responsive Table -->
            <div class="overflow-x-auto custom-scrollbar">
                <table class="w-full text-left border-collapse" id="keysTable">
                    <thead>
                        <tr class="bg-gray-900/80 text-[11px] font-mono uppercase tracking-wider text-gray-400 border-b border-gray-800">
                            <th class="py-3.5 px-4 font-semibold">Label / Owner</th>
                            <th class="py-3.5 px-4 font-semibold">API Key</th>
                            <th class="py-3.5 px-4 font-semibold">Assigned API</th>
                            <th class="py-3.5 px-4 font-semibold">Usage (Hits)</th>
                            <th class="py-3.5 px-4 font-semibold">Expiration</th>
                            <th class="py-3.5 px-4 font-semibold">Status</th>
                            <th class="py-3.5 px-4 font-semibold text-right">Actions</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-gray-800/60 text-xs">
                        <% if (keys && keys.length > 0) { %>
                            <% keys.forEach(function(key) { %>
                                <tr class="hover:bg-gray-800/30 transition group">
                                    <!-- Label / Owner -->
                                    <td class="py-4 px-4">
                                        <div class="font-semibold text-gray-200 text-sm"><%= key.name || 'Unnamed Key' %></div>
                                        <div class="text-[10px] text-gray-500 font-mono mt-0.5"><%= key.owner_username || owner %></div>
                                        <% if(key.note_enabled && key.key_note) { %>
                                            <div class="mt-1 text-[10px] text-amber-400/90 bg-amber-500/10 border border-amber-500/20 px-2 py-0.5 rounded w-fit inline-flex items-center gap-1">
                                                <i class="fa-solid fa-sticky-note text-[9px]"></i> <%= key.key_note %>
                                            </div>
                                        <% } %>
                                    </td>

                                    <!-- Key String -->
                                    <td class="py-4 px-4 font-mono">
                                        <div class="flex items-center gap-2">
                                            <span class="text-brand-cyan bg-cyan-950/40 border border-cyan-800/40 px-2.5 py-1 rounded-md tracking-wider"><%= key.key %></span>
                                            <button onclick="copyToClipboard('<%= key.key %>')" class="text-gray-500 hover:text-white transition p-1" title="Copy Key">
                                                <i class="fa-regular fa-copy"></i>
                                            </button>
                                        </div>
                                    </td>

                                    <!-- Allowed API -->
                                    <td class="py-4 px-4 font-mono">
                                        <% 
                                            let allowed = 'All APIs';
                                            try {
                                                let parsed = JSON.parse(key.allowed_apis);
                                                if (Array.isArray(parsed) && !parsed.includes('all')) {
                                                    allowed = parsed.join(', ');
                                                }
                                            } catch(e){}
                                        %>
                                        <span class="px-2 py-1 bg-gray-800 border border-gray-700 rounded text-gray-300 text-[11px]">
                                            <i class="fa-solid fa-cube text-brand-500 mr-1 text-[10px]"></i><%= allowed %>
                                        </span>
                                    </td>

                                    <!-- Hits / Limits -->
                                    <td class="py-4 px-4 font-mono">
                                        <div class="font-bold text-white"><%= key.hits %> hits</div>
                                        <div class="text-[10px] text-gray-400 mt-0.5">
                                            <% if (key.unlimited_hits) { %>
                                                <span class="text-emerald-400 font-semibold"><i class="fa-solid fa-infinity"></i> Unlimited</span>
                                            <% } else if(key.rate_limit_enabled) { %>
                                                <%= key.rate_limit_per_day %>/day
                                            <% } else { %>
                                                Standard
                                            <% } %>
                                        </div>
                                    </td>

                                    <!-- Expiration -->
                                    <td class="py-4 px-4">
                                        <% if (!key.expires_at) { %>
                                            <span class="text-gray-400 font-mono text-[11px]">Never</span>
                                        <% } else { 
                                            let exp = new Date(key.expires_at);
                                            let isExpired = exp < new Date();
                                        %>
                                            <div class="font-mono text-[11px] <%= isExpired ? 'text-red-400 line-through' : 'text-gray-300' %>">
                                                <%= exp.toLocaleDateString() %>
                                            </div>
                                            <div class="text-[10px] text-gray-500"><%= exp.toLocaleTimeString([], {hour: '2-digit', minute:'2-digit'}) %></div>
                                        <% } %>
                                    </td>

                                    <!-- Status Badge -->
                                    <td class="py-4 px-4">
                                        <div class="flex items-center gap-1.5">
                                            <% if (key.api_enabled === 0) { %>
                                                <span class="px-2.5 py-1 rounded-full text-[10px] font-semibold bg-red-500/10 text-red-400 border border-red-500/20 inline-flex items-center gap-1">
                                                    <i class="fa-solid fa-ban text-[8px]"></i> Disabled
                                                </span>
                                            <% } else if (key.status === 'active') { %>
                                                <span class="px-2.5 py-1 rounded-full text-[10px] font-semibold bg-emerald-500/10 text-emerald-400 border border-emerald-500/20 inline-flex items-center gap-1">
                                                    <i class="fa-solid fa-circle text-[6px]"></i> Active
                                                </span>
                                            <% } else { %>
                                                <span class="px-2.5 py-1 rounded-full text-[10px] font-semibold bg-amber-500/10 text-amber-400 border border-amber-500/20 inline-flex items-center gap-1">
                                                    <i class="fa-solid fa-circle text-[6px]"></i> <%= key.status %>
                                                </span>
                                            <% } %>
                                        </div>
                                    </td>

                                    <!-- Actions -->
                                    <td class="py-4 px-4 text-right">
                                        <div class="flex items-center justify-end gap-2">
                                            <!-- Edit Key Modal Trigger -->
                                            <button onclick="openEditModal('<%= JSON.stringify(key) %>')" class="p-2 rounded-lg bg-gray-800 hover:bg-gray-700 text-gray-300 hover:text-white transition" title="Edit Parameters">
                                                <i class="fa-solid fa-pen-to-square"></i>
                                            </button>

                                            <!-- Toggle Status Form -->
                                            <form action="/admin/toggle-status" method="POST" class="inline">
                                                <input type="hidden" name="id" value="<%= key.id %>">
                                                <input type="hidden" name="status" value="<%= key.status %>">
                                                <button type="submit" class="p-2 rounded-lg bg-gray-800 hover:bg-amber-500/20 text-gray-300 hover:text-amber-400 transition" title="Toggle Active/Disabled">
                                                    <i class="fa-solid fa-power-off"></i>
                                                </button>
                                            </form>

                                            <!-- Delete Key Form -->
                                            <form action="/admin/delete-key" method="POST" class="inline" onsubmit="return confirm('Are you sure you want to permanently remove this key?')">
                                                <input type="hidden" name="id" value="<%= key.id %>">
                                                <button type="submit" class="p-2 rounded-lg bg-gray-800 hover:bg-red-500/20 text-gray-300 hover:text-red-400 transition" title="Delete Key">
                                                    <i class="fa-solid fa-trash-can"></i>
                                                </button>
                                            </form>
                                        </div>
                                    </td>
                                </tr>
                            <% }); %>
                        <% } else { %>
                            <tr>
                                <td colspan="7" class="py-12 text-center text-gray-500">
                                    <i class="fa-solid fa-key-skeleton text-3xl mb-3 block opacity-40"></i>
                                    No API Keys found in system records. Generate your first key above.
                                </td>
                            </tr>
                        <% } %>
                    </tbody>
                </table>
            </div>
        </div>
    </main>

    <!-- Footer -->
    <footer class="border-t border-gray-800/80 bg-brand-dark/90 py-6 mt-12">
        <div class="max-w-7xl mx-auto px-4 text-center text-xs text-gray-500 flex flex-col sm:flex-row items-center justify-between gap-4">
            <div>
                Designed for <span class="text-gray-300 font-semibold"><%= owner %></span> &bull; Powered by OSINT Core
            </div>
            <div class="flex items-center gap-4">
                <a href="<%= channel %>" target="_blank" class="text-brand-cyan hover:underline flex items-center gap-1">
                    <i class="fa-brands fa-telegram"></i> Join Channel
                </a>
                <a href="/endpoints" class="text-gray-400 hover:text-white transition">Endpoints API</a>
                <a href="/docs" class="text-gray-400 hover:text-white transition">Documentation</a>
            </div>
        </div>
    </footer>

    <!-- ================= MODALS ================= -->

    <!-- GENERATE KEY MODAL -->
    <div id="generateModal" class="fixed inset-0 z-50 hidden bg-black/80 backdrop-blur-sm flex items-center justify-center p-4 overflow-y-auto">
        <div class="glass-card w-full max-w-lg rounded-2xl border border-gray-800 overflow-hidden shadow-2xl my-8">
            <div class="p-5 border-b border-gray-800 flex items-center justify-between bg-gray-900/60">
                <h3 class="text-base font-bold text-white flex items-center gap-2">
                    <i class="fa-solid fa-key text-brand-cyan"></i> Generate New API Key
                </h3>
                <button onclick="closeModal('generateModal')" class="text-gray-400 hover:text-white text-lg">&times;</button>
            </div>
            
            <form action="/admin/generate-key" method="POST" class="p-6 space-y-4">
                
                <!-- Label / Key Name -->
                <div>
                    <label class="block text-xs font-semibold text-gray-300 mb-1">Key Label / Client Name</label>
                    <input type="text" name="name" required placeholder="e.g. Premium Client - Sahil" 
                        class="w-full bg-gray-900 border border-gray-800 rounded-xl px-3.5 py-2.5 text-xs text-gray-200 focus:outline-none focus:border-brand-500 transition">
                </div>

                <!-- Custom Key Option -->
                <div class="p-3 bg-gray-900/60 border border-gray-800 rounded-xl space-y-2">
                    <div class="flex items-center justify-between">
                        <label for="enable_custom" class="text-xs font-semibold text-gray-300">Custom Key String</label>
                        <input type="checkbox" id="enable_custom" name="enable_custom" onchange="toggleCustomKeyInput(this.checked)" class="rounded bg-gray-800 border-gray-700 text-brand-500 focus:ring-0">
                    </div>
                    <input type="text" id="custom_key_input" name="custom_key" disabled placeholder="e.g. SAHIL_VIP_99" 
                        class="w-full bg-gray-950 border border-gray-800 rounded-lg px-3 py-2 text-xs text-gray-400 focus:outline-none focus:border-brand-500 transition disabled:opacity-40">
                </div>

                <!-- Single API Selection -->
                <div>
                    <label class="block text-xs font-semibold text-gray-300 mb-1">Allowed API Endpoint</label>
                    <select name="selected_api" class="w-full bg-gray-900 border border-gray-800 rounded-xl px-3.5 py-2.5 text-xs text-gray-200 focus:outline-none focus:border-brand-500 transition">
                        <option value="all">⚡ All Endpoints (Full Access)</option>
                        <% apis.forEach(function(api) { %>
                            <option value="<%= api.name %>"><%= api.display_name %> (<%= api.endpoint %>)</option>
                        <% }); %>
                    </select>
                </div>

                <!-- Expiry Options -->
                <div class="grid grid-cols-2 gap-3">
                    <div>
                        <label class="block text-xs font-semibold text-gray-300 mb-1">Validity Period</label>
                        <select name="expiry" id="expirySelect" onchange="toggleCustomExpiry(this.value)" class="w-full bg-gray-900 border border-gray-800 rounded-xl px-3.5 py-2.5 text-xs text-gray-200 focus:outline-none focus:border-brand-500 transition">
                            <option value="never">Lifetime (No Expiry)</option>
                            <option value="3d">3 Days</option>
                            <option value="7d">7 Days</option>
                            <option value="30d">30 Days</option>
                            <option value="custom">Custom Date</option>
                        </select>
                    </div>
                    <div>
                        <label class="block text-xs font-semibold text-gray-300 mb-1">Unlimited Usage</label>
                        <select name="unlimited_hits" class="w-full bg-gray-900 border border-gray-800 rounded-xl px-3.5 py-2.5 text-xs text-gray-200 focus:outline-none focus:border-brand-500 transition">
                            <option value="false">No (Rate Limited)</option>
                            <option value="true">Yes (Bypass Rate Limits)</option>
                        </select>
                    </div>
                </div>

                <!-- Custom Expiry Pickers -->
                <div id="customExpiryContainer" class="hidden grid grid-cols-2 gap-3 pt-1">
                    <div>
                        <label class="block text-[11px] text-gray-400 mb-1">Expiry Date</label>
                        <input type="date" name="custom_expiry_date" class="w-full bg-gray-900 border border-gray-800 rounded-xl px-3 py-2 text-xs text-gray-200">
                    </div>
                    <div>
                        <label class="block text-[11px] text-gray-400 mb-1">Expiry Time</label>
                        <input type="time" name="custom_expiry_time" value="23:59" class="w-full bg-gray-900 border border-gray-800 rounded-xl px-3 py-2 text-xs text-gray-200">
                    </div>
                </div>

                <!-- Rate Limit Configuration -->
                <div class="p-3 bg-gray-900/60 border border-gray-800 rounded-xl space-y-3">
                    <div class="flex items-center justify-between">
                        <label class="text-xs font-semibold text-gray-300">Enable Rate Limits</label>
                        <input type="checkbox" name="rate_limit_enabled" checked class="rounded bg-gray-800 border-gray-700 text-brand-500">
                    </div>
                    <div class="grid grid-cols-3 gap-2 text-xs">
                        <div>
                            <span class="text-[10px] text-gray-400">Daily</span>
                            <input type="number" name="rate_limit_per_day" value="100" class="w-full bg-gray-950 border border-gray-800 rounded-lg p-1.5 text-center text-gray-200">
                        </div>
                        <div>
                            <span class="text-[10px] text-gray-400">Hourly</span>
                            <input type="number" name="rate_limit_per_hour" value="20" class="w-full bg-gray-950 border border-gray-800 rounded-lg p-1.5 text-center text-gray-200">
                        </div>
                        <div>
                            <span class="text-[10px] text-gray-400">Per Min</span>
                            <input type="number" name="rate_limit_per_minute" value="5" class="w-full bg-gray-950 border border-gray-800 rounded-lg p-1.5 text-center text-gray-200">
                        </div>
                    </div>
                </div>

                <!-- Note Option -->
                <div class="space-y-2">
                    <div class="flex items-center justify-between">
                        <label class="text-xs font-semibold text-gray-300">Attach Custom Note</label>
                        <input type="checkbox" name="note_enabled" onchange="document.getElementById('key_note_input').classList.toggle('hidden')" class="rounded bg-gray-800 border-gray-700 text-brand-500">
                    </div>
                    <input type="text" id="key_note_input" name="key_note" placeholder="Optional note for key owner..." 
                        class="hidden w-full bg-gray-900 border border-gray-800 rounded-xl px-3.5 py-2 text-xs text-gray-200">
                </div>

                <!-- Submit Button -->
                <div class="pt-2">
                    <button type="submit" class="w-full py-3 bg-gradient-to-r from-brand-600 to-brand-cyan hover:from-brand-700 hover:to-cyan-600 text-white font-semibold rounded-xl text-xs transition shadow-lg shadow-brand-600/20">
                        Generate Key Now
                    </button>
                </div>
            </form>
        </div>
    </div>

    <!-- EDIT KEY MODAL -->
    <div id="editModal" class="fixed inset-0 z-50 hidden bg-black/80 backdrop-blur-sm flex items-center justify-center p-4 overflow-y-auto">
        <div class="glass-card w-full max-w-lg rounded-2xl border border-gray-800 overflow-hidden shadow-2xl my-8">
            <div class="p-5 border-b border-gray-800 flex items-center justify-between bg-gray-900/60">
                <h3 class="text-base font-bold text-white flex items-center gap-2">
                    <i class="fa-solid fa-sliders text-brand-cyan"></i> Edit API Key Settings
                </h3>
                <button onclick="closeModal('editModal')" class="text-gray-400 hover:text-white text-lg">&times;</button>
            </div>
            
            <form id="editKeyForm" onsubmit="submitEditKey(event)" class="p-6 space-y-4">
                <input type="hidden" id="edit_key_id" name="key_id">

                <!-- Key Label -->
                <div>
                    <label class="block text-xs font-semibold text-gray-300 mb-1">Key Label</label>
                    <input type="text" id="edit_name" name="name" required 
                        class="w-full bg-gray-900 border border-gray-800 rounded-xl px-3.5 py-2.5 text-xs text-gray-200 focus:outline-none focus:border-brand-500 transition">
                </div>

                <!-- Single API Selection -->
                <div>
                    <label class="block text-xs font-semibold text-gray-300 mb-1">Allowed API Endpoint</label>
                    <select id="edit_selected_api" name="selected_api" class="w-full bg-gray-900 border border-gray-800 rounded-xl px-3.5 py-2.5 text-xs text-gray-200 focus:outline-none focus:border-brand-500 transition">
                        <option value="all">⚡ All Endpoints (Full Access)</option>
                        <% apis.forEach(function(api) { %>
                            <option value="<%= api.name %>"><%= api.display_name %></option>
                        <% }); %>
                    </select>
                </div>

                <!-- Toggle Key Active / Disable Status -->
                <div class="grid grid-cols-2 gap-3">
                    <div>
                        <label class="block text-xs font-semibold text-gray-300 mb-1">API Execution Status</label>
                        <select id="edit_api_enabled" name="api_enabled" class="w-full bg-gray-900 border border-gray-800 rounded-xl px-3.5 py-2.5 text-xs text-gray-200">
                            <option value="1">Enabled</option>
                            <option value="0">Disabled by Admin</option>
                        </select>
                    </div>
                    <div>
                        <label class="block text-xs font-semibold text-gray-300 mb-1">Unlimited Hits</label>
                        <select id="edit_unlimited_hits" name="unlimited_hits" class="w-full bg-gray-900 border border-gray-800 rounded-xl px-3.5 py-2.5 text-xs text-gray-200">
                            <option value="false">No (Rate Limited)</option>
                            <option value="true">Yes (Unlimited)</option>
                        </select>
                    </div>
                </div>

                <!-- Rate Limits -->
                <div class="p-3 bg-gray-900/60 border border-gray-800 rounded-xl space-y-3">
                    <div class="flex items-center justify-between">
                        <label class="text-xs font-semibold text-gray-300">Rate Limit Status</label>
                        <input type="checkbox" id="edit_rate_limit_enabled" name="rate_limit_enabled" class="rounded bg-gray-800 border-gray-700 text-brand-500">
                    </div>
                    <div class="grid grid-cols-3 gap-2 text-xs">
                        <div>
                            <span class="text-[10px] text-gray-400">Daily</span>
                            <input type="number" id="edit_rate_limit_per_day" name="rate_limit_per_day" class="w-full bg-gray-950 border border-gray-800 rounded-lg p-1.5 text-center text-gray-200">
                        </div>
                        <div>
                            <span class="text-[10px] text-gray-400">Hourly</span>
                            <input type="number" id="edit_rate_limit_per_hour" name="rate_limit_per_hour" class="w-full bg-gray-950 border border-gray-800 rounded-lg p-1.5 text-center text-gray-200">
                        </div>
                        <div>
                            <span class="text-[10px] text-gray-400">Per Min</span>
                            <input type="number" id="edit_rate_limit_per_minute" name="rate_limit_per_minute" class="w-full bg-gray-950 border border-gray-800 rounded-lg p-1.5 text-center text-gray-200">
                        </div>
                    </div>
                </div>

                <!-- Custom Note -->
                <div class="space-y-2">
                    <div class="flex items-center justify-between">
                        <label class="text-xs font-semibold text-gray-300">Note Attached</label>
                        <input type="checkbox" id="edit_note_enabled" name="note_enabled" class="rounded bg-gray-800 border-gray-700 text-brand-500">
                    </div>
                    <input type="text" id="edit_key_note" name="key_note" placeholder="Key note..." 
                        class="w-full bg-gray-900 border border-gray-800 rounded-xl px-3.5 py-2 text-xs text-gray-200">
                </div>

                <!-- Submit Button -->
                <div class="pt-2">
                    <button type="submit" class="w-full py-3 bg-brand-600 hover:bg-brand-700 text-white font-semibold rounded-xl text-xs transition">
                        Update Key Settings
                    </button>
                </div>
            </form>
        </div>
    </div>

    <!-- Scripts -->
    <script>
        function openModal(id) { document.getElementById(id).classList.remove('hidden'); }
        function closeModal(id) { document.getElementById(id).classList.add('hidden'); }

        function toggleCustomKeyInput(checked) {
            const input = document.getElementById('custom_key_input');
            input.disabled = !checked;
            if(checked) input.focus();
        }

        function toggleCustomExpiry(val) {
            const container = document.getElementById('customExpiryContainer');
            if (val === 'custom') container.classList.remove('hidden');
            else container.classList.add('hidden');
        }

        function copyToClipboard(text) {
            navigator.clipboard.writeText(text).then(() => {
                alert('API Key copied to clipboard!');
            });
        }

        function filterKeys() {
            const input = document.getElementById("searchInput").value.toUpperCase();
            const tr = document.getElementById("keysTable").getElementsByTagName("tr");
            for (let i = 1; i < tr.length; i++) {
                let tdName = tr[i].getElementsByTagName("td")[0];
                let tdKey = tr[i].getElementsByTagName("td")[1];
                if (tdName || tdKey) {
                    let txtValueName = tdName.textContent || tdName.innerText;
                    let txtValueKey = tdKey.textContent || tdKey.innerText;
                    if (txtValueName.toUpperCase().indexOf(input) > -1 || txtValueKey.toUpperCase().indexOf(input) > -1) {
                        tr[i].style.display = "";
                    } else {
                        tr[i].style.display = "none";
                    }
                }
            }
        }

        function openEditModal(keyObjStr) {
            const key = JSON.parse(keyObjStr);
            document.getElementById('edit_key_id').value = key.id;
            document.getElementById('edit_name').value = key.name || '';
            document.getElementById('edit_api_enabled').value = key.api_enabled !== undefined ? key.api_enabled : 1;
            document.getElementById('edit_unlimited_hits').value = key.unlimited_hits ? 'true' : 'false';
            
            // Set Single API Selection
            try {
                let allowed = JSON.parse(key.allowed_apis);
                if(Array.isArray(allowed) && allowed.length > 0) {
                    document.getElementById('edit_selected_api').value = allowed[0];
                } else {
                    document.getElementById('edit_selected_api').value = 'all';
                }
            } catch(e) {
                document.getElementById('edit_selected_api').value = 'all';
            }

            document.getElementById('edit_rate_limit_enabled').checked = key.rate_limit_enabled === 1;
            document.getElementById('edit_rate_limit_per_day').value = key.rate_limit_per_day || 100;
            document.getElementById('edit_rate_limit_per_hour').value = key.rate_limit_per_hour || 20;
            document.getElementById('edit_rate_limit_per_minute').value = key.rate_limit_per_minute || 5;

            document.getElementById('edit_note_enabled').checked = key.note_enabled === 1;
            document.getElementById('edit_key_note').value = key.key_note || '';

            openModal('editModal');
        }

        async function submitEditKey(e) {
            e.preventDefault();
            const form = document.getElementById('editKeyForm');
            const formData = new FormData(form);
            const data = Object.fromEntries(formData.entries());

            try {
                const res = await fetch('/admin/edit-key', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(data)
                });
                const result = await res.json();
                if (result.success) {
                    window.location.reload();
                } else {
                    alert('Error: ' + (result.error || 'Failed to update key'));
                }
            } catch(err) {
                alert('Request failed');
            }
        }
    </script>
</body>
</html>
