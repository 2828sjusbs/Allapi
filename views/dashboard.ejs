<!DOCTYPE html>
<html lang="en" class="dark">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Dashboard — OSINT API Hub</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;700&display=swap" rel="stylesheet">
  <script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/4.4.0/chart.umd.min.js"></script>
  <style>
    body{background:#080c14;font-family:'Plus Jakarta Sans',sans-serif;color:#f3f4f6;}
    .glass{background:rgba(17,24,39,0.6);backdrop-filter:blur(12px);border:1px solid rgba(255,255,255,0.06);}
    .cs::-webkit-scrollbar{width:4px;height:4px;}.cs::-webkit-scrollbar-track{background:#080c14;}.cs::-webkit-scrollbar-thumb{background:#1f2937;border-radius:4px;}
  </style>
</head>
<body class="min-h-screen cs">
<%- include('_nav', { currentPage: 'dashboard', user: user }) %>
<main class="pt-20 max-w-[1400px] mx-auto px-4 sm:px-6 pb-12">

  <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-8">
    <div>
      <h1 class="text-2xl font-extrabold text-white">Dashboard</h1>
      <p class="text-sm text-gray-500 mt-0.5">API Key management & system overview</p>
    </div>
    <button onclick="openModal('generateModal')" class="flex items-center gap-2 px-5 py-2.5 bg-gradient-to-r from-cyan-500 to-indigo-600 hover:from-cyan-400 hover:to-indigo-500 text-white font-semibold rounded-xl text-sm shadow-lg shadow-cyan-500/20 transition">
      <i class="fa-solid fa-plus"></i> Generate Key
    </button>
  </div>

  <!-- Stats -->
  <div class="grid grid-cols-2 lg:grid-cols-4 gap-4 mb-8">
    <div class="glass rounded-2xl p-5" style="box-shadow:0 0 30px rgba(99,102,241,0.08)">
      <div class="flex items-center justify-between mb-3">
        <span class="text-xs text-gray-500 uppercase tracking-wider font-semibold">Total Keys</span>
        <div class="p-2 rounded-lg bg-indigo-500/10 border border-indigo-500/20"><i class="fa-solid fa-key text-indigo-400 text-sm"></i></div>
      </div>
      <div class="text-3xl font-extrabold text-white font-mono"><%= keys.length %></div>
      <div class="text-xs text-gray-600 mt-1">All registered keys</div>
    </div>
    <div class="glass rounded-2xl p-5" style="box-shadow:0 0 30px rgba(16,185,129,0.08)">
      <div class="flex items-center justify-between mb-3">
        <span class="text-xs text-gray-500 uppercase tracking-wider font-semibold">Active</span>
        <div class="p-2 rounded-lg bg-emerald-500/10 border border-emerald-500/20"><i class="fa-solid fa-shield-check text-emerald-400 text-sm"></i></div>
      </div>
      <div class="text-3xl font-extrabold text-emerald-400 font-mono"><%= active %></div>
      <div class="text-xs text-emerald-500/60 mt-1">Live & operational</div>
    </div>
    <div class="glass rounded-2xl p-5" style="box-shadow:0 0 30px rgba(6,182,212,0.08)">
      <div class="flex items-center justify-between mb-3">
        <span class="text-xs text-gray-500 uppercase tracking-wider font-semibold">Total Hits</span>
        <div class="p-2 rounded-lg bg-cyan-500/10 border border-cyan-500/20"><i class="fa-solid fa-bolt text-cyan-400 text-sm"></i></div>
      </div>
      <div class="text-3xl font-extrabold text-cyan-400 font-mono"><%= totalHits || 0 %></div>
      <div class="text-xs text-gray-600 mt-1">Cumulative requests</div>
    </div>
    <div class="glass rounded-2xl p-5" style="box-shadow:0 0 30px rgba(168,85,247,0.08)">
      <div class="flex items-center justify-between mb-3">
        <span class="text-xs text-gray-500 uppercase tracking-wider font-semibold">Endpoints</span>
        <div class="p-2 rounded-lg bg-purple-500/10 border border-purple-500/20"><i class="fa-solid fa-cubes text-purple-400 text-sm"></i></div>
      </div>
      <div class="text-3xl font-extrabold text-purple-400 font-mono"><%= apis.length %></div>
      <div class="text-xs text-gray-600 mt-1">Active modules</div>
    </div>
  </div>

  <!-- Charts -->
  <div class="grid grid-cols-1 lg:grid-cols-2 gap-5 mb-8">
    <div class="glass rounded-2xl p-6">
      <div class="flex items-center justify-between mb-4">
        <div><h3 class="text-sm font-bold text-white">Request Volume</h3><p class="text-xs text-gray-500">Last 7 days</p></div>
        <a href="/admin/analytics" class="text-xs text-cyan-400 hover:text-cyan-300 transition flex items-center gap-1">Full Analytics <i class="fa-solid fa-arrow-right text-[10px]"></i></a>
      </div>
      <div style="height:180px"><canvas id="dailyChart"></canvas></div>
    </div>
    <div class="glass rounded-2xl p-6">
      <div class="flex items-center justify-between mb-4">
        <div><h3 class="text-sm font-bold text-white">Top Endpoints</h3><p class="text-xs text-gray-500">By hit count</p></div>
        <a href="/admin/analytics" class="text-xs text-cyan-400 hover:text-cyan-300 transition flex items-center gap-1">View All <i class="fa-solid fa-arrow-right text-[10px]"></i></a>
      </div>
      <div style="height:180px"><canvas id="endpointsChart"></canvas></div>
    </div>
  </div>

  <!-- Banner -->
  <div class="glass rounded-2xl p-5 mb-8">
    <div class="flex flex-col lg:flex-row lg:items-center gap-4">
      <div class="flex items-center gap-2 flex-shrink-0">
        <i class="fa-solid fa-bullhorn text-amber-400 text-sm"></i>
        <span class="text-xs font-bold text-gray-300 uppercase tracking-wider">Maintenance Banner</span>
      </div>
      <form action="/admin/update-settings" method="POST" class="flex flex-1 flex-col sm:flex-row gap-3">
        <input type="text" name="maintenance_message" value="<%= settings.maintenance_message %>" placeholder="Enter maintenance message..."
          class="flex-1 bg-[#0d1420] border border-gray-800 focus:border-amber-500/50 rounded-xl px-4 py-2 text-sm text-gray-200 outline-none transition">
        <button type="submit" class="px-4 py-2 bg-amber-500/15 hover:bg-amber-500/25 border border-amber-500/25 text-amber-400 rounded-xl text-xs font-semibold transition flex items-center gap-2">
          <i class="fa-solid fa-floppy-disk"></i> Save
        </button>
      </form>
    </div>
  </div>

  <!-- Keys Table -->
  <div class="glass rounded-2xl overflow-hidden">
    <div class="p-5 border-b border-white/5 flex flex-col sm:flex-row sm:items-center justify-between gap-4">
      <div class="flex items-center gap-3">
        <h2 class="text-base font-bold text-white">API Keys</h2>
        <span class="text-xs font-mono bg-gray-800 border border-gray-700 text-gray-400 px-2 py-0.5 rounded-full"><%= keys.length %></span>
      </div>
      <div class="relative">
        <i class="fa-solid fa-magnifying-glass absolute left-3 top-1/2 -translate-y-1/2 text-gray-600 text-xs"></i>
        <input type="text" id="searchInput" onkeyup="filterKeys()" placeholder="Search name, key..."
          class="bg-[#0d1420] border border-gray-800 rounded-xl pl-8 pr-4 py-2 text-xs text-gray-300 placeholder-gray-600 outline-none focus:border-cyan-500/40 transition w-full sm:w-56">
      </div>
    </div>
    <div class="overflow-x-auto cs">
      <table class="w-full text-left" id="keysTable">
        <thead class="text-[10px] font-mono uppercase tracking-wider text-gray-500 border-b border-white/5 bg-gray-900/40">
          <tr>
            <th class="py-3 px-4">Label / Owner</th>
            <th class="py-3 px-4">API Key</th>
            <th class="py-3 px-4">Endpoint</th>
            <th class="py-3 px-4">Hits</th>
            <th class="py-3 px-4">Expires</th>
            <th class="py-3 px-4">Status</th>
            <th class="py-3 px-4 text-right">Actions</th>
          </tr>
        </thead>
        <tbody class="text-xs divide-y divide-white/[0.04]">
          <% if (keys && keys.length > 0) { %>
            <% keys.forEach(function(key) {
              let allowed = 'All APIs';
              try { let p=JSON.parse(key.allowed_apis); if(Array.isArray(p)&&!p.includes('all')) allowed=p.join(', '); } catch(e){}
              const exp = key.expires_at ? new Date(key.expires_at) : null;
              const isExpired = exp && exp < new Date();
            %>
            <tr class="hover:bg-white/[0.02] transition">
              <td class="py-3.5 px-4">
                <div class="font-semibold text-gray-200"><%= key.name || 'Unnamed Key' %></div>
                <div class="text-[10px] text-gray-600 font-mono"><%= key.owner_username || owner %></div>
                <% if(key.note_enabled && key.key_note) { %>
                  <span class="mt-1 text-[10px] text-amber-400 bg-amber-500/10 border border-amber-500/20 px-1.5 py-0.5 rounded inline-block"><i class="fa-solid fa-note-sticky text-[9px] mr-0.5"></i><%= key.key_note %></span>
                <% } %>
              </td>
              <td class="py-3.5 px-4 font-mono">
                <div class="flex items-center gap-2">
                  <span class="text-cyan-400 bg-cyan-950/50 border border-cyan-800/30 px-2 py-1 rounded text-[11px] tracking-wide"><%= key.key %></span>
                  <button onclick="copyKey('<%= key.key %>')" class="text-gray-600 hover:text-gray-300 transition" title="Copy"><i class="fa-regular fa-copy text-xs"></i></button>
                </div>
              </td>
              <td class="py-3.5 px-4 font-mono">
                <span class="px-2 py-1 bg-gray-800/80 border border-gray-700/50 rounded text-gray-400 text-[11px]">
                  <i class="fa-solid fa-cube text-indigo-400 mr-1 text-[9px]"></i><%= allowed %>
                </span>
              </td>
              <td class="py-3.5 px-4 font-mono">
                <div class="font-bold text-white"><%= key.hits %></div>
                <div class="text-[10px] text-gray-600">
                  <% if(key.unlimited_hits){%><span class="text-emerald-400"><i class="fa-solid fa-infinity"></i> Unlimited</span><%}else if(key.rate_limit_enabled){%><%= key.rate_limit_per_day %>/day<%}else{%>Standard<%}%>
                </div>
              </td>
              <td class="py-3.5 px-4">
                <% if(!exp){%><span class="text-gray-500 font-mono text-[11px]">Never</span><%}else{%>
                  <div class="font-mono text-[11px] <%=isExpired?'text-red-400 line-through':'text-gray-300'%>"><%= exp.toLocaleDateString() %></div>
                  <div class="text-[10px] text-gray-600"><%= exp.toLocaleTimeString([],{hour:'2-digit',minute:'2-digit'}) %></div>
                <%}%>
              </td>
              <td class="py-3.5 px-4">
                <%if(key.api_enabled===0){%>
                  <span class="px-2 py-1 rounded-full text-[10px] font-bold bg-red-500/10 text-red-400 border border-red-500/20 inline-flex items-center gap-1"><i class="fa-solid fa-ban text-[8px]"></i> Disabled</span>
                <%}else if(key.status==='active'){%>
                  <span class="px-2 py-1 rounded-full text-[10px] font-bold bg-emerald-500/10 text-emerald-400 border border-emerald-500/20 inline-flex items-center gap-1"><span class="w-1.5 h-1.5 rounded-full bg-emerald-400 inline-block"></span> Active</span>
                <%}else{%>
                  <span class="px-2 py-1 rounded-full text-[10px] font-bold bg-amber-500/10 text-amber-400 border border-amber-500/20 inline-flex items-center gap-1"><span class="w-1.5 h-1.5 rounded-full bg-amber-400 inline-block"></span> <%= key.status %></span>
                <%}%>
              </td>
              <td class="py-3.5 px-4">
                <div class="flex items-center justify-end gap-1.5">
                  <button onclick="openEditModal('<%- JSON.stringify(key).replace(/\\/g,'\\\\').replace(/'/g,\"\\'\\'\") %>')" class="p-1.5 rounded-lg bg-gray-800 hover:bg-indigo-500/20 text-gray-400 hover:text-indigo-400 transition" title="Edit"><i class="fa-solid fa-pen-to-square text-xs"></i></button>
                  <form action="/admin/toggle-status" method="POST" class="inline">
                    <input type="hidden" name="id" value="<%= key.id %>"><input type="hidden" name="status" value="<%= key.status %>">
                    <button type="submit" class="p-1.5 rounded-lg bg-gray-800 hover:bg-amber-500/20 text-gray-400 hover:text-amber-400 transition" title="Toggle"><i class="fa-solid fa-power-off text-xs"></i></button>
                  </form>
                  <form action="/admin/delete-key" method="POST" class="inline" onsubmit="return confirm('Delete this key permanently?')">
                    <input type="hidden" name="id" value="<%= key.id %>">
                    <button type="submit" class="p-1.5 rounded-lg bg-gray-800 hover:bg-red-500/20 text-gray-400 hover:text-red-400 transition" title="Delete"><i class="fa-solid fa-trash-can text-xs"></i></button>
                  </form>
                </div>
              </td>
            </tr>
            <% }); %>
          <% } else { %>
            <tr><td colspan="7" class="py-16 text-center text-gray-600"><i class="fa-solid fa-key text-3xl block mb-3 opacity-30"></i>No API keys found. Generate your first key.</td></tr>
          <% } %>
        </tbody>
      </table>
    </div>
  </div>
</main>

<!-- GENERATE MODAL -->
<div id="generateModal" class="fixed inset-0 z-50 hidden bg-black/70 backdrop-blur-sm flex items-center justify-center p-4 overflow-y-auto">
  <div class="glass w-full max-w-lg rounded-2xl border border-white/8 shadow-2xl my-8">
    <div class="p-5 border-b border-white/5 flex items-center justify-between">
      <h3 class="text-sm font-bold text-white flex items-center gap-2"><i class="fa-solid fa-key text-cyan-400"></i> Generate New API Key</h3>
      <button onclick="closeModal('generateModal')" class="text-gray-500 hover:text-white text-xl leading-none">&times;</button>
    </div>
    <form action="/admin/generate-key" method="POST" class="p-6 space-y-4">
      <div>
        <label class="block text-xs font-semibold text-gray-400 mb-1 uppercase tracking-wider">Label / Client Name</label>
        <input type="text" name="name" required placeholder="e.g. Premium Client" class="w-full bg-[#0d1420] border border-gray-800 focus:border-cyan-500/50 rounded-xl px-4 py-2.5 text-sm text-gray-200 outline-none transition">
      </div>
      <div class="p-3 bg-gray-900/50 border border-gray-800 rounded-xl space-y-2">
        <div class="flex items-center justify-between">
          <label class="text-xs font-semibold text-gray-400">Custom Key String</label>
          <input type="checkbox" id="enable_custom" name="enable_custom" onchange="document.getElementById('custom_key_input').disabled=!this.checked" class="rounded">
        </div>
        <input type="text" id="custom_key_input" name="custom_key" disabled placeholder="e.g. SAHIL_VIP_99" class="w-full bg-[#070b11] border border-gray-800 rounded-lg px-3 py-2 text-xs text-gray-400 outline-none disabled:opacity-30 transition">
      </div>
      <div>
        <label class="block text-xs font-semibold text-gray-400 mb-1 uppercase tracking-wider">Allowed Endpoint</label>
        <select name="selected_api" class="w-full bg-[#0d1420] border border-gray-800 rounded-xl px-4 py-2.5 text-xs text-gray-200 outline-none">
          <option value="all">⚡ All Endpoints (Full Access)</option>
          <% apis.forEach(function(api){%><option value="<%= api.name %>"><%= api.display_name %> (<%= api.endpoint %>)</option><%});%>
        </select>
      </div>
      <div class="grid grid-cols-2 gap-3">
        <div>
          <label class="block text-xs font-semibold text-gray-400 mb-1">Validity</label>
          <select name="expiry" id="expirySelect" onchange="toggleCustomExpiry(this.value)" class="w-full bg-[#0d1420] border border-gray-800 rounded-xl px-3 py-2.5 text-xs text-gray-200 outline-none">
            <option value="never">Lifetime</option><option value="3d">3 Days</option><option value="7d">7 Days</option><option value="30d">30 Days</option><option value="custom">Custom</option>
          </select>
        </div>
        <div>
          <label class="block text-xs font-semibold text-gray-400 mb-1">Unlimited Usage</label>
          <select name="unlimited_hits" class="w-full bg-[#0d1420] border border-gray-800 rounded-xl px-3 py-2.5 text-xs text-gray-200 outline-none">
            <option value="false">No (Rate Limited)</option><option value="true">Yes (Unlimited)</option>
          </select>
        </div>
      </div>
      <div id="customExpiryContainer" class="hidden grid grid-cols-2 gap-3">
        <div><label class="block text-[11px] text-gray-500 mb-1">Expiry Date</label><input type="date" name="custom_expiry_date" class="w-full bg-[#0d1420] border border-gray-800 rounded-xl px-3 py-2 text-xs text-gray-200 outline-none"></div>
        <div><label class="block text-[11px] text-gray-500 mb-1">Expiry Time</label><input type="time" name="custom_expiry_time" value="23:59" class="w-full bg-[#0d1420] border border-gray-800 rounded-xl px-3 py-2 text-xs text-gray-200 outline-none"></div>
      </div>
      <div class="p-3 bg-gray-900/50 border border-gray-800 rounded-xl space-y-3">
        <div class="flex items-center justify-between">
          <label class="text-xs font-semibold text-gray-400">Enable Rate Limits</label>
          <input type="checkbox" name="rate_limit_enabled" checked class="rounded">
        </div>
        <div class="grid grid-cols-3 gap-2 text-xs">
          <div><span class="text-[10px] text-gray-600">Daily</span><input type="number" name="rate_limit_per_day" value="100" class="w-full bg-[#070b11] border border-gray-800 rounded-lg p-1.5 text-center text-gray-200 outline-none"></div>
          <div><span class="text-[10px] text-gray-600">Hourly</span><input type="number" name="rate_limit_per_hour" value="20" class="w-full bg-[#070b11] border border-gray-800 rounded-lg p-1.5 text-center text-gray-200 outline-none"></div>
          <div><span class="text-[10px] text-gray-600">Per Min</span><input type="number" name="rate_limit_per_minute" value="5" class="w-full bg-[#070b11] border border-gray-800 rounded-lg p-1.5 text-center text-gray-200 outline-none"></div>
        </div>
      </div>
      <div class="space-y-2">
        <div class="flex items-center justify-between">
          <label class="text-xs font-semibold text-gray-400">Attach Note</label>
          <input type="checkbox" name="note_enabled" onchange="document.getElementById('key_note_input').classList.toggle('hidden')" class="rounded">
        </div>
        <input type="text" id="key_note_input" name="key_note" placeholder="Optional note..." class="hidden w-full bg-[#0d1420] border border-gray-800 rounded-xl px-4 py-2 text-xs text-gray-200 outline-none">
      </div>
      <button type="submit" class="w-full py-3 bg-gradient-to-r from-cyan-500 to-indigo-600 hover:from-cyan-400 hover:to-indigo-500 text-white font-bold rounded-xl text-sm transition shadow-lg">Generate Key</button>
    </form>
  </div>
</div>

<!-- EDIT MODAL -->
<div id="editModal" class="fixed inset-0 z-50 hidden bg-black/70 backdrop-blur-sm flex items-center justify-center p-4 overflow-y-auto">
  <div class="glass w-full max-w-lg rounded-2xl border border-white/8 shadow-2xl my-8">
    <div class="p-5 border-b border-white/5 flex items-center justify-between">
      <h3 class="text-sm font-bold text-white flex items-center gap-2"><i class="fa-solid fa-sliders text-cyan-400"></i> Edit Key Settings</h3>
      <button onclick="closeModal('editModal')" class="text-gray-500 hover:text-white text-xl leading-none">&times;</button>
    </div>
    <form id="editKeyForm" onsubmit="submitEditKey(event)" class="p-6 space-y-4">
      <input type="hidden" id="edit_key_id" name="key_id">
      <div>
        <label class="block text-xs font-semibold text-gray-400 mb-1">Label</label>
        <input type="text" id="edit_name" name="name" required class="w-full bg-[#0d1420] border border-gray-800 focus:border-cyan-500/50 rounded-xl px-4 py-2.5 text-sm text-gray-200 outline-none transition">
      </div>
      <div>
        <label class="block text-xs font-semibold text-gray-400 mb-1">Allowed Endpoint</label>
        <select id="edit_selected_api" name="selected_api" class="w-full bg-[#0d1420] border border-gray-800 rounded-xl px-4 py-2.5 text-xs text-gray-200 outline-none">
          <option value="all">⚡ All Endpoints</option>
          <% apis.forEach(function(api){%><option value="<%= api.name %>"><%= api.display_name %></option><%});%>
        </select>
      </div>
      <div class="grid grid-cols-2 gap-3">
        <div>
          <label class="block text-xs font-semibold text-gray-400 mb-1">Status</label>
          <select id="edit_api_enabled" name="api_enabled" class="w-full bg-[#0d1420] border border-gray-800 rounded-xl px-3 py-2.5 text-xs text-gray-200 outline-none">
            <option value="1">Enabled</option><option value="0">Disabled</option>
          </select>
        </div>
        <div>
          <label class="block text-xs font-semibold text-gray-400 mb-1">Unlimited Hits</label>
          <select id="edit_unlimited_hits" name="unlimited_hits" class="w-full bg-[#0d1420] border border-gray-800 rounded-xl px-3 py-2.5 text-xs text-gray-200 outline-none">
            <option value="false">No (Rate Limited)</option><option value="true">Yes (Unlimited)</option>
          </select>
        </div>
      </div>
      <div class="p-3 bg-gray-900/50 border border-gray-800 rounded-xl space-y-3">
        <div class="flex items-center justify-between">
          <label class="text-xs font-semibold text-gray-400">Rate Limits</label>
          <input type="checkbox" id="edit_rate_limit_enabled" name="rate_limit_enabled" class="rounded">
        </div>
        <div class="grid grid-cols-3 gap-2 text-xs">
          <div><span class="text-[10px] text-gray-600">Daily</span><input type="number" id="edit_rate_limit_per_day" name="rate_limit_per_day" class="w-full bg-[#070b11] border border-gray-800 rounded-lg p-1.5 text-center text-gray-200 outline-none"></div>
          <div><span class="text-[10px] text-gray-600">Hourly</span><input type="number" id="edit_rate_limit_per_hour" name="rate_limit_per_hour" class="w-full bg-[#070b11] border border-gray-800 rounded-lg p-1.5 text-center text-gray-200 outline-none"></div>
          <div><span class="text-[10px] text-gray-600">Per Min</span><input type="number" id="edit_rate_limit_per_minute" name="rate_limit_per_minute" class="w-full bg-[#070b11] border border-gray-800 rounded-lg p-1.5 text-center text-gray-200 outline-none"></div>
        </div>
      </div>
      <div class="space-y-2">
        <div class="flex items-center justify-between">
          <label class="text-xs font-semibold text-gray-400">Note</label>
          <input type="checkbox" id="edit_note_enabled" name="note_enabled" class="rounded">
        </div>
        <input type="text" id="edit_key_note" name="key_note" placeholder="Note..." class="w-full bg-[#0d1420] border border-gray-800 rounded-xl px-4 py-2 text-xs text-gray-200 outline-none">
      </div>
      <button type="submit" class="w-full py-3 bg-indigo-600 hover:bg-indigo-500 text-white font-bold rounded-xl text-sm transition">Update Key</button>
    </form>
  </div>
</div>

<!-- Toast -->
<div id="toast" class="fixed bottom-6 right-6 z-50 hidden bg-gray-900 border border-gray-700 text-white text-xs px-4 py-3 rounded-xl shadow-xl flex items-center gap-2">
  <i class="fa-solid fa-check text-emerald-400"></i> <span id="toastMsg">Copied!</span>
</div>

<script>
const dailyVolumeData = <%- JSON.stringify(dailyVolume||[]) %>;
const topEndpointsData = <%- JSON.stringify(topEndpoints||[]) %>;

new Chart(document.getElementById('dailyChart'),{type:'line',data:{labels:dailyVolumeData.map(d=>d.date),datasets:[{label:'Requests',data:dailyVolumeData.map(d=>d.total),borderColor:'#06b6d4',backgroundColor:'rgba(6,182,212,0.08)',tension:0.4,fill:true,pointRadius:4,pointBackgroundColor:'#06b6d4',borderWidth:2}]},options:{responsive:true,maintainAspectRatio:false,plugins:{legend:{display:false}},scales:{x:{ticks:{color:'#6b7280',font:{size:10}},grid:{color:'rgba(255,255,255,0.03)'}},y:{ticks:{color:'#6b7280',font:{size:10}},grid:{color:'rgba(255,255,255,0.04)'}}}}});

new Chart(document.getElementById('endpointsChart'),{type:'bar',data:{labels:topEndpointsData.map(d=>d.endpoint),datasets:[{label:'Hits',data:topEndpointsData.map(d=>d.hits),backgroundColor:['rgba(99,102,241,0.7)','rgba(6,182,212,0.7)','rgba(16,185,129,0.7)','rgba(245,158,11,0.7)','rgba(239,68,68,0.7)'],borderRadius:6,borderWidth:0}]},options:{responsive:true,maintainAspectRatio:false,plugins:{legend:{display:false}},scales:{x:{ticks:{color:'#6b7280',font:{size:10}},grid:{color:'rgba(255,255,255,0.03)'}},y:{ticks:{color:'#6b7280',font:{size:10}},grid:{color:'rgba(255,255,255,0.04)'}}}}});

function openModal(id){document.getElementById(id).classList.remove('hidden');}
function closeModal(id){document.getElementById(id).classList.add('hidden');}
function toggleCustomExpiry(v){const c=document.getElementById('customExpiryContainer');v==='custom'?c.classList.remove('hidden'):c.classList.add('hidden');}
function copyKey(text){navigator.clipboard.writeText(text).then(()=>{document.getElementById('toastMsg').textContent='Key copied!';const t=document.getElementById('toast');t.classList.remove('hidden');setTimeout(()=>t.classList.add('hidden'),2000);});}
function filterKeys(){const val=document.getElementById('searchInput').value.toUpperCase();document.getElementById('keysTable').querySelectorAll('tbody tr').forEach(tr=>{tr.style.display=tr.textContent.toUpperCase().includes(val)?'':'none';});}
function openEditModal(str){
  const key=JSON.parse(str);
  document.getElementById('edit_key_id').value=key.id;
  document.getElementById('edit_name').value=key.name||'';
  document.getElementById('edit_api_enabled').value=key.api_enabled!==undefined?key.api_enabled:1;
  document.getElementById('edit_unlimited_hits').value=key.unlimited_hits?'true':'false';
  try{let a=JSON.parse(key.allowed_apis);document.getElementById('edit_selected_api').value=(Array.isArray(a)&&a.length>0)?a[0]:'all';}catch(e){document.getElementById('edit_selected_api').value='all';}
  document.getElementById('edit_rate_limit_enabled').checked=key.rate_limit_enabled===1;
  document.getElementById('edit_rate_limit_per_day').value=key.rate_limit_per_day||100;
  document.getElementById('edit_rate_limit_per_hour').value=key.rate_limit_per_hour||20;
  document.getElementById('edit_rate_limit_per_minute').value=key.rate_limit_per_minute||5;
  document.getElementById('edit_note_enabled').checked=key.note_enabled===1;
  document.getElementById('edit_key_note').value=key.key_note||'';
  openModal('editModal');
}
async function submitEditKey(e){
  e.preventDefault();
  const data=Object.fromEntries(new FormData(document.getElementById('editKeyForm')).entries());
  const res=await fetch('/admin/edit-key',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(data)});
  const result=await res.json();
  if(result.success)window.location.reload();
  else alert('Error: '+(result.error||'Failed'));
}
</script>
</body>
</html>
