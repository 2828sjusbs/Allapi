<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>OSINT API Hub — Admin</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=JetBrains+Mono:wght@400;600&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
    <style>
        :root {
            --bg:        #0a0c10;
            --surface:   #10141c;
            --panel:     #151b27;
            --border:    #1f2a3c;
            --border-hi: #2a3a55;
            --accent:    #3b82f6;
            --accent-lo: rgba(59,130,246,.10);
            --accent-md: rgba(59,130,246,.25);
            --emerald:   #10b981;
            --rose:      #f43f5e;
            --amber:     #f59e0b;
            --text-1:    #e8edf5;
            --text-2:    #8a9ab5;
            --text-3:    #4d607a;
            --mono:      'JetBrains Mono', monospace;
            --sans:      'Inter', system-ui, sans-serif;
            --radius:    10px;
            --radius-lg: 16px;
        }
        *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
        body { font-family: var(--sans); background: var(--bg); color: var(--text-1); min-height: 100vh; line-height: 1.5; }
        .shell { position: relative; z-index: 1; display: flex; min-height: 100vh; }
        .sidebar { width: 220px; flex-shrink: 0; background: var(--surface); border-right: 1px solid var(--border); display: flex; flex-direction: column; padding: 24px 0; position: fixed; inset: 0 auto 0 0; }
        .logo { padding: 0 20px 28px; display: flex; align-items: center; gap: 10px; border-bottom: 1px solid var(--border); margin-bottom: 20px; }
        .logo-icon { width: 36px; height: 36px; background: var(--accent); border-radius: 8px; display: grid; place-items: center; font-size: 16px; color: #fff; }
        .logo-text { font-weight: 700; font-size: 15px; letter-spacing: -.3px; }
        .logo-sub  { font-size: 10px; color: var(--text-3); letter-spacing: .8px; text-transform: uppercase; }
        .nav-label { font-size: 10px; color: var(--text-3); letter-spacing: 1px; text-transform: uppercase; padding: 0 20px 8px; }
        .nav-item { display: flex; align-items: center; gap: 10px; padding: 10px 20px; font-size: 13px; font-weight: 500; color: var(--text-2); cursor: pointer; transition: all .15s; border-left: 2px solid transparent; text-decoration: none; }
        .nav-item:hover  { color: var(--text-1); background: rgba(255,255,255,.03); }
        .nav-item.active { color: var(--accent); border-left-color: var(--accent); background: var(--accent-lo); }
        .sidebar-footer { margin-top: auto; padding: 16px 20px; border-top: 1px solid var(--border); }
        .user-badge { display: flex; align-items: center; gap: 10px; font-size: 12px; }
        .avatar { width: 30px; height: 30px; background: var(--accent-md); border: 1px solid var(--accent); border-radius: 50%; display: grid; place-items: center; font-size: 11px; color: var(--accent); font-weight: 700; }
        .logout-btn { display: flex; align-items: center; gap: 6px; margin-top: 10px; padding: 7px 12px; border: 1px solid var(--border); border-radius: 6px; background: transparent; color: var(--text-2); font-size: 12px; cursor: pointer; text-decoration: none; transition: all .15s; width: 100%; justify-content: center; }
        .logout-btn:hover { border-color: var(--rose); color: var(--rose); }
        .main { margin-left: 220px; flex: 1; }
        .topbar { height: 56px; display: flex; align-items: center; justify-content: space-between; padding: 0 28px; border-bottom: 1px solid var(--border); background: var(--surface); position: sticky; top: 0; z-index: 10; }
        .live-dot { display: flex; align-items: center; gap: 7px; font-size: 11px; color: var(--emerald); }
        .live-dot::before { content: ''; width: 7px; height: 7px; border-radius: 50%; background: var(--emerald); animation: pulse 1.8s infinite; }
        @keyframes pulse { 0%{ box-shadow:0 0 0 0 rgba(16,185,129,.5);} 70%{box-shadow:0 0 0 6px rgba(16,185,129,0);} 100%{box-shadow:0 0 0 0 rgba(16,185,129,0);} }
        .content { padding: 28px; }
        .stats { display: grid; grid-template-columns: repeat(4, 1fr); gap: 14px; margin-bottom: 28px; }
        .stat { background: var(--panel); border: 1px solid var(--border); border-radius: var(--radius-lg); padding: 22px 24px; position: relative; overflow: hidden; }
        .stat-label { font-size: 11px; color: var(--text-3); text-transform: uppercase; letter-spacing: .8px; margin-bottom: 10px; display: flex; align-items: center; gap: 6px; }
        .stat-val { font-family: var(--mono); font-size: 32px; font-weight: 600; }
        .grid { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; }
        .panel { background: var(--panel); border: 1px solid var(--border); border-radius: var(--radius-lg); overflow: hidden; }
        .panel-head { display: flex; align-items: center; gap: 10px; padding: 16px 20px; border-bottom: 1px solid var(--border); font-size: 13px; font-weight: 600; }
        .panel-body { padding: 20px; }
        .field { margin-bottom: 16px; }
        label { display: block; font-size: 11px; font-weight: 600; color: var(--text-2); text-transform: uppercase; margin-bottom: 7px; }
        input[type="text"], input[type="number"], input[type="date"], input[type="time"], select, textarea { width: 100%; background: var(--bg); border: 1px solid var(--border); border-radius: var(--radius); padding: 9px 12px; font-size: 13px; color: var(--text-1); outline: none; }
        input:focus, select:focus, textarea:focus { border-color: var(--accent); }
        .toggle-group { display: flex; gap: 8px; }
        .toggle-opt { flex: 1; display: flex; align-items: center; gap: 8px; padding: 9px 12px; border: 1px solid var(--border); border-radius: var(--radius); cursor: pointer; font-size: 12px; color: var(--text-2); }
        .toggle-opt input { display: none; }
        .toggle-opt:has(input:checked) { border-color: var(--accent); background: var(--accent-lo); color: var(--accent); }
        .toggle-dot { width: 14px; height: 14px; border-radius: 50%; border: 2px solid var(--border-hi); }
        .toggle-opt:has(input:checked) .toggle-dot { border-color: var(--accent); background: var(--accent); }
        .btn-primary { width: 100%; padding: 11px; background: var(--accent); border: none; border-radius: var(--radius); font-size: 13px; font-weight: 600; color: white; cursor: pointer; transition: all .15s; margin-top: 8px; }
        .btn-primary:hover { background: #2563eb; }
        .tbl-wrap { overflow: auto; max-height: 540px; }
        table { width: 100%; border-collapse: collapse; font-size: 12px; }
        thead th { padding: 10px 14px; text-align: left; font-size: 10px; color: var(--text-3); text-transform: uppercase; border-bottom: 1px solid var(--border); position: sticky; top: 0; background: var(--panel); }
        tbody tr { border-bottom: 1px solid var(--border); }
        td { padding: 11px 14px; }
        .key-code { font-family: var(--mono); font-size: 11px; background: var(--bg); border: 1px solid var(--border); padding: 3px 7px; border-radius: 4px; color: var(--accent); }
        .badge { display: inline-flex; align-items: center; padding: 3px 8px; border-radius: 20px; font-size: 10px; font-weight: 700; text-transform: uppercase; }
        .badge-active  { background: rgba(16,185,129,.12); color: #10b981; border: 1px solid rgba(16,185,129,.25); }
        .badge-disabled { background: rgba(244,63,94,.1); color: #f43f5e; border: 1px solid rgba(244,63,94,.2); }
        .badge-expired { background: rgba(245,158,11,.1); color: #f59e0b; border: 1px solid rgba(245,158,11,.2); }
        .row-actions { display: flex; gap: 5px; }
        .action-btn { width: 28px; height: 28px; display: grid; place-items: center; border-radius: 6px; border: 1px solid var(--border); background: var(--bg); color: var(--text-2); cursor: pointer; font-size: 11px; }
        .action-btn.warn:hover { border-color: #f59e0b; color: #f59e0b; }
        .action-btn.danger:hover { border-color: #f43f5e; color: #f43f5e; }
        .master-card { background: var(--panel); border: 1px solid var(--border); border-radius: var(--radius-lg); padding: 20px; margin-bottom: 20px; }
        .toggle-switch { width: 50px; height: 28px; background: rgba(148,163,184,.2); border: 1px solid var(--border); border-radius: 14px; cursor: pointer; position: relative; transition: all .3s; }
        .toggle-switch.active { background: rgba(16,185,129,.3); border-color: var(--emerald); }
        .toggle-switch .slider { position: absolute; top: 2px; left: 2px; width: 24px; height: 24px; background: white; border-radius: 11px; transition: all .3s; }
        .toggle-switch.active .slider { left: 24px; }
        .modal { display: none; position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,.7); z-index: 1000; align-items: center; justify-content: center; }
        .modal.active { display: flex; }
        .modal-content { background: var(--panel); border: 1px solid var(--border); border-radius: var(--radius-lg); padding: 24px; max-width: 500px; width: 90%; }
        .modal-close { float: right; background: none; border: none; color: var(--text-2); cursor: pointer; font-size: 16px; }
        .foot { text-align: center; padding: 20px 0; font-size: 11px; color: var(--text-3); border-top: 1px solid var(--border); margin-top: 28px; }
        .foot a { color: var(--accent); text-decoration: none; }
        @media (max-width: 1024px) { .grid { grid-template-columns: 1fr; } .stats { grid-template-columns: repeat(2, 1fr); } }
        @media (max-width: 768px) { .sidebar { display: none; } .main { margin-left: 0; } .stats { grid-template-columns: 1fr; } }
        .hidden { display: none !important; }
    </style>
</head>
<body>
<div class="shell">
    <aside class="sidebar">
        <div class="logo">
            <div class="logo-icon"><i class="fas fa-satellite-dish"></i></div>
            <div>
                <div class="logo-text">OSINT Hub</div>
                <div class="logo-sub">API Control</div>
            </div>
        </div>
        <div class="nav-label">Overview</div>
        <a class="nav-item active" href="#"><i class="fas fa-gauge-high"></i> Dashboard</a>
        <div class="sidebar-footer">
            <div class="user-badge">
                <div class="avatar"><%= user.username[0].toUpperCase() %></div>
                <div>
                    <div class="user-name"><%= user.username %></div>
                    <div class="user-role"><%= user.role %></div>
                </div>
            </div>
            <a href="/logout" class="logout-btn"><i class="fas fa-arrow-right-from-bracket"></i> Sign Out</a>
        </div>
    </aside>

    <main class="main">
        <div class="topbar">
            <div class="topbar-title">Dashboard <span>/ Overview</span></div>
            <div class="live-dot">System Online</div>
        </div>
        <div class="content">
            <div class="stats">
                <div class="stat">
                    <div class="stat-label"><i class="fas fa-bolt"></i> Total Hits</div>
                    <div class="stat-val"><%= (totalHits ?? 0).toLocaleString() %></div>
                </div>
                <div class="stat">
                    <div class="stat-label"><i class="fas fa-key"></i> Total Keys</div>
                    <div class="stat-val"><%= keys.length %></div>
                </div>
                <div class="stat">
                    <div class="stat-label"><i class="fas fa-circle-check"></i> Active Keys</div>
                    <div class="stat-val"><%= active %></div>
                </div>
                <div class="stat">
                    <div class="stat-label"><i class="fas fa-cube"></i> Endpoints</div>
                    <div class="stat-val"><%= apis.length %></div>
                </div>
            </div>

            <!-- Master API Control -->
            <div class="master-card">
                <div style="font-size:13px;font-weight:600;color:var(--accent);margin-bottom:12px;"><i class="fas fa-server"></i> Master System Status</div>
                <div style="display:flex;align-items:center;gap:12px;margin-bottom:12px;">
                    <div class="toggle-switch <%= settings && settings.master_api == 1 ? 'active' : '' %>" id="masterToggle" onclick="toggleMasterApi()">
                        <div class="slider"></div>
                    </div>
                    <span style="font-weight:600;" id="masterStatus">
                        <%= settings && settings.master_api == 1 ? '🟢 ONLINE' : '🔴 OFFLINE' %>
                    </span>
                </div>
                <div class="field">
                    <label>Maintenance Message</label>
                    <textarea id="maintenanceMessage" rows="2" placeholder="Maintenance message..."><%= settings ? settings.maintenance_message : '' %></textarea>
                    <button class="btn-primary" onclick="saveMasterSettings()" style="margin-top:8px;padding:8px;"><i class="fas fa-save"></i> Save System Config</button>
                    <div id="masterSaveStatus" style="font-size:11px;margin-top:6px;"></div>
                </div>
            </div>

            <div class="grid">
                <!-- Generate Key Form -->
                <div class="panel">
                    <div class="panel-head"><i class="fas fa-plus-circle"></i> Generate API Key</div>
                    <div class="panel-body">
                        <form method="POST" action="/admin/generate-key">
                            <div class="field">
                                <label>Customer Name</label>
                                <input type="text" name="name" placeholder="e.g. John Doe" required>
                            </div>
                            <div class="field">
                                <label>App Name</label>
                                <input type="text" name="app_name" placeholder="e.g. OSINT App">
                            </div>
                            <div class="field">
                                <label>Custom Key String (Optional)</label>
                                <div style="display:flex;align-items:center;gap:8px;">
                                    <label class="toggle-opt" style="flex:0 0 auto;">
                                        <input type="checkbox" id="enableCustomKey" name="enable_custom" value="on" onchange="document.getElementById('customKey').style.display = this.checked ? 'block' : 'none'">
                                        <div class="toggle-dot"></div>
                                        <span>Custom</span>
                                    </label>
                                    <input type="text" name="custom_key" id="customKey" placeholder="KEY_NAME" style="display:none;flex:1;">
                                </div>
                            </div>
                            <div class="field">
                                <label>Select Allowed API</label>
                                <select name="allowed_apis">
                                    <option value="all" selected>All Available APIs</option>
                                    <% apis.forEach(api => { %>
                                        <option value="<%= api.name %>"><%= api.display_name %> (<%= api.name %>)</option>
                                    <% }); %>
                                </select>
                            </div>
                            <div style="display:grid;grid-template-columns:1fr 1fr;gap:12px;">
                                <div class="field">
                                    <label>Validity</label>
                                    <select name="expiry" id="expirySelect" onchange="document.getElementById('customExpiryDiv').style.display = this.value === 'custom' ? 'block' : 'none'">
                                        <option value="7d">7 Days</option>
                                        <option value="15d">15 Days</option>
                                        <option value="1m" selected>30 Days</option>
                                        <option value="1y">1 Year</option>
                                        <option value="custom">Custom Date</option>
                                        <option value="">Never Expires</option>
                                    </select>
                                </div>
                                <div class="field">
                                    <label>Daily Rate Limit</label>
                                    <input type="number" name="daily_limit" value="100">
                                </div>
                            </div>
                            <div id="customExpiryDiv" class="field hidden">
                                <label>Custom Expiry Date</label>
                                <input type="date" name="custom_expiry_date">
                                <input type="time" name="custom_expiry_time" style="margin-top:6px;">
                            </div>
                            <div class="field">
                                <label>Access Mode</label>
                                <div class="toggle-group">
                                    <label class="toggle-opt">
                                        <input type="radio" name="limit_type" value="unlimited" checked onchange="document.getElementById('maxTotalHitsDiv').style.display = 'none'">
                                        <div class="toggle-dot"></div>
                                        Unlimited
                                    </label>
                                    <label class="toggle-opt">
                                        <input type="radio" name="limit_type" value="limited" onchange="document.getElementById('maxTotalHitsDiv').style.display = 'block'">
                                        <div class="toggle-dot"></div>
                                        Hits Limit
                                    </label>
                                </div>
                            </div>
                            <div id="maxTotalHitsDiv" class="field hidden">
                                <label>Max Total Hits Cap</label>
                                <input type="number" name="max_total_hits" value="50">
                            </div>
                            <div class="field">
                                <label>Per Hour / Per Minute Rate Limits</label>
                                <div style="display:grid;grid-template-columns:1fr 1fr;gap:10px;">
                                    <input type="number" name="rate_limit_hour" value="20" placeholder="Hour Limit">
                                    <input type="number" name="rate_limit_minute" value="5" placeholder="Minute Limit">
                                </div>
                            </div>
                            <div class="field">
                                <label>IP Whitelist (Optional)</label>
                                <input type="text" name="ip_whitelist" placeholder="Comma separated IPs">
                            </div>
                            <div class="field">
                                <label>Key Note</label>
                                <div style="display:flex;align-items:center;gap:8px;margin-bottom:6px;">
                                    <label class="toggle-opt" style="flex:0 0 auto;">
                                        <input type="checkbox" id="enableNote" name="note_enabled" value="on" onchange="document.getElementById('keyNote').style.display = this.checked ? 'block' : 'none'">
                                        <div class="toggle-dot"></div>
                                        <span>Add Note</span>
                                    </label>
                                </div>
                                <input type="text" name="key_note" id="keyNote" placeholder="e.g. VIP Customer" style="display:none;">
                            </div>
                            <button type="submit" class="btn-primary"><i class="fas fa-key"></i> Issue Key</button>
                        </form>
                    </div>
                </div>

                <!-- API Keys Table -->
                <div class="panel">
                    <div class="panel-head">
                        <i class="fas fa-list-ul"></i> Issued Keys
                        <span style="margin-left:auto;font-size:11px;color:var(--text-3);"><%= keys.length %> Keys</span>
                    </div>
                    <div class="tbl-wrap">
                        <table>
                            <thead>
                                <tr><th>Key</th><th>Name</th><th>Hits</th><th>Expires</th><th>Status</th><th>Actions</th></tr>
                            </thead>
                            <tbody>
                                <% keys.forEach(key => { 
                                    const isExpired = key.expires_at && new Date(key.expires_at) < new Date();
                                    const status = isExpired ? 'expired' : (key.status || 'active');
                                %>
                                <tr>
                                    <td><span class="key-code"><%= key.key %></span></td>
                                    <td><%= key.name || '—' %></td>
                                    <td><%= key.hits %>/<%= key.max_total_hits > 0 ? key.max_total_hits : '∞' %></td>
                                    <td><span id="timer-<%= key.id %>" data-expires="<%= key.expires_at %>">—</span></td>
                                    <td><span class="badge badge-<%= status %>"><%= status %></span></td>
                                    <td>
                                        <div class="row-actions">
                                            <button class="action-btn warn" onclick="openEditModal('<%= key.id %>', '<%= key.name || '' %>', '<%= key.expires_at || '' %>', '<%= key.status || 'active' %>', <%= key.unlimited_hits || 0 %>, <%= key.note_enabled || 0 %>, '<%= (key.key_note || '').replace(/'/g, "&apos;") %>')"><i class="fas fa-edit"></i></button>
                                            <form method="POST" action="/admin/toggle-status" style="display:contents">
                                                <input type="hidden" name="id" value="<%= key.id %>">
                                                <input type="hidden" name="status" value="<%= key.status %>">
                                                <button type="submit" class="action-btn warn"><i class="fas fa-power-off"></i></button>
                                            </form>
                                            <form method="POST" action="/admin/delete-key" style="display:contents" onsubmit="return confirm('Delete this key?')">
                                                <input type="hidden" name="id" value="<%= key.id %>">
                                                <button type="submit" class="action-btn danger"><i class="fas fa-trash"></i></button>
                                            </form>
                                        </div>
                                    </td>
                                </tr>
                                <% }); %>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            <div class="foot">
                Owner: <a href="https://t.me/<%= owner.replace('@','') %>"><%= owner %></a> &nbsp;·&nbsp; Channel: <a href="https://t.me/<%= channel.replace('@','') %>"><%= channel %></a>
            </div>
        </div>
    </main>
</div>

<!-- Modal Edit -->
<div class="modal" id="editModal">
    <div class="modal-content">
        <button class="modal-close" onclick="closeEditModal()">&times;</button>
        <div style="font-size:14px;font-weight:600;color:var(--accent);margin-bottom:16px;"><i class="fas fa-edit"></i> Edit Key</div>
        <form id="editForm" method="POST" action="/admin/edit-key">
            <input type="hidden" name="key_id" id="editKeyId">
            <div class="field">
                <label>Key Name</label>
                <input type="text" name="name" id="editName" required>
            </div>
            <div class="field">
                <label>Update Expiry Date</label>
                <input type="date" name="custom_expiry_date" id="editDate">
                <input type="time" name="custom_expiry_time" id="editTime" style="margin-top:6px;">
            </div>
            <div class="field">
                <label>Status</label>
                <select name="status" id="editStatus">
                    <option value="active">Active</option>
                    <option value="disabled">Disabled</option>
                    <option value="expired">Expired</option>
                </select>
            </div>
            <div class="field">
                <label style="display:flex;align-items:center;gap:8px;text-transform:none;">
                    <input type="checkbox" name="unlimited_hits" id="editUnlimited"> Unlimited Hits
                </label>
            </div>
            <div class="field">
                <label style="display:flex;align-items:center;gap:8px;text-transform:none;">
                    <input type="checkbox" name="note_enabled" id="editNoteEnabled" onchange="document.getElementById('editKeyNote').style.display = this.checked ? 'block' : 'none'"> Add Note
                </label>
                <input type="text" name="key_note" id="editKeyNote" placeholder="Key Note..." style="margin-top:6px;display:none;">
            </div>
            <button type="submit" class="btn-primary" style="margin-top:12px;">Save Changes</button>
        </form>
    </div>
</div>

<script>
    function toggleMasterApi() {
        const toggle = document.getElementById('masterToggle');
        const status = document.getElementById('masterStatus');
        toggle.classList.toggle('active');
        const isActive = toggle.classList.contains('active');
        status.textContent = isActive ? '🟢 ONLINE' : '🔴 OFFLINE';
    }

    async function saveMasterSettings() {
        const toggle = document.getElementById('masterToggle');
        const message = document.getElementById('maintenanceMessage').value;
        const masterApi = toggle.classList.contains('active') ? 1 : 0;
        const statusDiv = document.getElementById('masterSaveStatus');
        
        statusDiv.textContent = '⏳ Saving...';
        
        try {
            const response = await fetch('/admin/update-settings', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ master_api: masterApi, maintenance_message: message })
            });
            const data = await response.json();
            if (data.success) {
                statusDiv.textContent = '✅ Saved Successfully!';
                statusDiv.style.color = 'var(--emerald)';
            } else {
                statusDiv.textContent = '❌ Save Failed';
                statusDiv.style.color = 'var(--rose)';
            }
        } catch(e) {
            statusDiv.textContent = '❌ Error saving settings';
            statusDiv.style.color = 'var(--rose)';
        }
    }

    function openEditModal(id, name, expiresAt, status, unlimited, noteEnabled, keyNote) {
        document.getElementById('editKeyId').value = id;
        document.getElementById('editName').value = name;
        document.getElementById('editStatus').value = status;
        document.getElementById('editUnlimited').checked = unlimited == 1;
        document.getElementById('editNoteEnabled').checked = noteEnabled == 1;
        document.getElementById('editKeyNote').value = keyNote || '';
        document.getElementById('editKeyNote').style.display = noteEnabled == 1 ? 'block' : 'none';
        
        if (expiresAt && expiresAt.trim() !== '') {
            try {
                const date = new Date(expiresAt);
                if (!isNaN(date)) {
                    document.getElementById('editDate').value = date.toISOString().split('T')[0];
                    document.getElementById('editTime').value = date.toTimeString().slice(0,5);
                }
            } catch(e) {}
        }
        document.getElementById('editModal').classList.add('active');
    }

    function closeEditModal() {
        document.getElementById('editModal').classList.remove('active');
    }

    function updateTimers() {
        document.querySelectorAll('[data-expires]').forEach(el => {
            const expiresAt = el.dataset.expires;
            if (!expiresAt) { el.textContent = 'Never'; return; }
            
            const expiry = new Date(expiresAt);
            const diff = expiry - new Date();
            
            if (diff <= 0) {
                el.textContent = 'Expired';
                el.style.color = 'var(--rose)';
                return;
            }
            
            const days = Math.floor(diff / (1000*60*60*24));
            const hours = Math.floor((diff % (1000*60*60*24)) / (1000*60*60));
            const mins = Math.floor((diff % (1000*60*60)) / (1000*60));
            
            el.textContent = `${days > 0 ? days + 'd ' : ''}${hours}h ${mins}m`;
        });
    }

    setInterval(updateTimers, 1000);
    updateTimers();
</script>
</body>
</html>
