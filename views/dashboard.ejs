<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Admin Dashboard - OSINT API Hub</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }
        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background: #0a0e1a;
            color: #e0e0e0;
            min-height: 100vh;
        }
        .container {
            max-width: 1400px;
            margin: 0 auto;
            padding: 20px;
        }
        .header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 15px 0;
            border-bottom: 1px solid #1e2a3a;
            margin-bottom: 30px;
        }
        .header h1 {
            font-size: 24px;
            background: linear-gradient(135deg, #00d4ff, #7b2ffc);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }
        .user-info {
            display: flex;
            align-items: center;
            gap: 15px;
        }
        .user-info .badge {
            background: #1e2a3a;
            padding: 5px 15px;
            border-radius: 20px;
            font-size: 12px;
            color: #00d4ff;
        }
        .btn-logout {
            background: #ff4444;
            color: white;
            border: none;
            padding: 8px 20px;
            border-radius: 5px;
            cursor: pointer;
            font-weight: bold;
        }
        .btn-logout:hover {
            background: #cc0000;
        }
        .stats-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
            gap: 20px;
            margin-bottom: 30px;
        }
        .stat-card {
            background: #141e2b;
            padding: 20px;
            border-radius: 12px;
            border: 1px solid #1e2a3a;
        }
        .stat-card .number {
            font-size: 32px;
            font-weight: bold;
            background: linear-gradient(135deg, #00d4ff, #7b2ffc);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }
        .stat-card .label {
            font-size: 14px;
            color: #8899aa;
            margin-top: 5px;
        }

        /* Master API Card */
        .master-api-card {
            background: #141e2b;
            border-radius: 12px;
            padding: 25px;
            border: 1px solid #1e2a3a;
            margin-bottom: 30px;
        }
        .master-api-card .card-title {
            font-size: 20px;
            font-weight: bold;
            margin-bottom: 15px;
            color: #00d4ff;
        }
        .master-api-card .toggle-row {
            display: flex;
            align-items: center;
            gap: 20px;
            margin-bottom: 15px;
            flex-wrap: wrap;
        }
        .toggle-switch {
            position: relative;
            width: 60px;
            height: 30px;
            background: #1e2a3a;
            border-radius: 15px;
            cursor: pointer;
            transition: 0.3s;
        }
        .toggle-switch.active {
            background: #00d4ff;
        }
        .toggle-switch .slider {
            position: absolute;
            top: 3px;
            left: 3px;
            width: 24px;
            height: 24px;
            background: white;
            border-radius: 50%;
            transition: 0.3s;
        }
        .toggle-switch.active .slider {
            left: 33px;
        }
        .toggle-status {
            font-weight: bold;
            font-size: 16px;
        }
        .toggle-status.on {
            color: #00d4ff;
        }
        .toggle-status.off {
            color: #ff4444;
        }
        .master-api-card textarea {
            width: 100%;
            padding: 12px;
            background: #0a0e1a;
            border: 1px solid #1e2a3a;
            border-radius: 8px;
            color: #e0e0e0;
            font-size: 14px;
            resize: vertical;
            min-height: 60px;
            margin-bottom: 15px;
        }
        .master-api-card .btn-save {
            background: linear-gradient(135deg, #00d4ff, #7b2ffc);
            color: white;
            border: none;
            padding: 10px 30px;
            border-radius: 8px;
            cursor: pointer;
            font-weight: bold;
            transition: 0.3s;
        }
        .master-api-card .btn-save:hover {
            opacity: 0.8;
            transform: scale(1.02);
        }

        /* Key Cards */
        .key-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(400px, 1fr));
            gap: 20px;
            margin-top: 20px;
        }
        .key-card {
            background: #141e2b;
            border-radius: 12px;
            padding: 20px;
            border: 1px solid #1e2a3a;
            position: relative;
            transition: 0.3s;
        }
        .key-card:hover {
            border-color: #00d4ff;
            transform: translateY(-2px);
        }
        .key-card .key-name {
            font-size: 18px;
            font-weight: bold;
            color: #00d4ff;
        }
        .key-card .key-value {
            font-family: monospace;
            background: #0a0e1a;
            padding: 5px 10px;
            border-radius: 4px;
            margin: 5px 0 10px;
            font-size: 13px;
            word-break: break-all;
            color: #7bff9e;
        }
        .key-card .status-badge {
            display: inline-block;
            padding: 3px 12px;
            border-radius: 20px;
            font-size: 11px;
            font-weight: bold;
        }
        .status-badge.active {
            background: #00d4ff22;
            color: #00d4ff;
            border: 1px solid #00d4ff44;
        }
        .status-badge.disabled {
            background: #ff444422;
            color: #ff4444;
            border: 1px solid #ff444444;
        }
        .status-badge.expired {
            background: #ff880022;
            color: #ff8800;
            border: 1px solid #ff880044;
        }
        .key-card .info-row {
            display: flex;
            justify-content: space-between;
            padding: 5px 0;
            font-size: 13px;
            border-bottom: 1px solid #1e2a3a33;
        }
        .key-card .info-row .label {
            color: #8899aa;
        }
        .key-card .info-row .value {
            color: #e0e0e0;
        }
        .key-card .timer {
            font-family: monospace;
            font-size: 16px;
            font-weight: bold;
            color: #00d4ff;
            padding: 8px;
            background: #0a0e1a;
            border-radius: 8px;
            text-align: center;
            margin: 10px 0;
        }
        .key-card .timer.expired {
            color: #ff4444;
        }
        .key-card .badges {
            display: flex;
            gap: 8px;
            flex-wrap: wrap;
            margin: 8px 0;
        }
        .key-card .badge-item {
            padding: 2px 10px;
            border-radius: 12px;
            font-size: 11px;
            font-weight: bold;
        }
        .badge-item.unlimited {
            background: #7bff9e22;
            color: #7bff9e;
            border: 1px solid #7bff9e44;
        }
        .badge-item.note {
            background: #ffbb0022;
            color: #ffbb00;
            border: 1px solid #ffbb0044;
        }
        .key-card .actions {
            display: flex;
            gap: 8px;
            margin-top: 12px;
            flex-wrap: wrap;
        }
        .key-card .actions button {
            padding: 5px 15px;
            border: none;
            border-radius: 5px;
            cursor: pointer;
            font-size: 12px;
            font-weight: bold;
            transition: 0.3s;
        }
        .btn-edit {
            background: #007bff;
            color: white;
        }
        .btn-edit:hover {
            background: #0056b3;
        }
        .btn-delete {
            background: #dc3545;
            color: white;
        }
        .btn-delete:hover {
            background: #a71d2a;
        }
        .btn-toggle {
            background: #6c757d;
            color: white;
        }
        .btn-toggle:hover {
            background: #5a6268;
        }
        .btn-toggle.active-btn {
            background: #28a745;
        }
        .btn-toggle.active-btn:hover {
            background: #1e7e34;
        }

        /* Modal */
        .modal {
            display: none;
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(0,0,0,0.8);
            z-index: 1000;
            justify-content: center;
            align-items: center;
        }
        .modal.active {
            display: flex;
        }
        .modal-content {
            background: #141e2b;
            border-radius: 12px;
            padding: 30px;
            max-width: 600px;
            width: 90%;
            max-height: 90vh;
            overflow-y: auto;
            border: 1px solid #1e2a3a;
        }
        .modal-content h2 {
            color: #00d4ff;
            margin-bottom: 20px;
        }
        .modal-content .form-group {
            margin-bottom: 15px;
        }
        .modal-content .form-group label {
            display: block;
            margin-bottom: 5px;
            color: #8899aa;
            font-size: 13px;
            font-weight: bold;
        }
        .modal-content .form-group input,
        .modal-content .form-group select,
        .modal-content .form-group textarea {
            width: 100%;
            padding: 10px;
            background: #0a0e1a;
            border: 1px solid #1e2a3a;
            border-radius: 6px;
            color: #e0e0e0;
            font-size: 14px;
        }
        .modal-content .form-group textarea {
            resize: vertical;
            min-height: 60px;
        }
        .modal-content .form-group .checkbox-group {
            display: flex;
            gap: 10px;
            flex-wrap: wrap;
        }
        .modal-content .form-group .checkbox-group label {
            display: flex;
            align-items: center;
            gap: 5px;
            font-weight: normal;
            color: #e0e0e0;
            cursor: pointer;
        }
        .modal-content .form-group .checkbox-group input[type="checkbox"] {
            width: auto;
            accent-color: #00d4ff;
        }
        .modal-content .form-row {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 15px;
        }
        .modal-content .btn-submit {
            background: linear-gradient(135deg, #00d4ff, #7b2ffc);
            color: white;
            border: none;
            padding: 12px 30px;
            border-radius: 8px;
            cursor: pointer;
            font-weight: bold;
            width: 100%;
            transition: 0.3s;
        }
        .modal-content .btn-submit:hover {
            opacity: 0.8;
        }
        .modal-content .btn-close {
            background: #dc3545;
            color: white;
            border: none;
            padding: 10px 20px;
            border-radius: 8px;
            cursor: pointer;
            font-weight: bold;
            margin-top: 10px;
        }
        .modal-content .btn-close:hover {
            background: #a71d2a;
        }

        /* Responsive */
        @media (max-width: 768px) {
            .key-grid {
                grid-template-columns: 1fr;
            }
            .header {
                flex-direction: column;
                gap: 10px;
                text-align: center;
            }
            .modal-content {
                padding: 20px;
            }
            .modal-content .form-row {
                grid-template-columns: 1fr;
            }
            .master-api-card .toggle-row {
                flex-direction: column;
                align-items: stretch;
                gap: 10px;
            }
        }
    </style>
</head>
<body>
    <div class="container">
        <div class="header">
            <h1>🔐 OSINT API Hub — Admin Dashboard</h1>
            <div class="user-info">
                <span class="badge">👤 <%= user.username %> (<%= user.role %>)</span>
                <a href="/logout" class="btn-logout">Logout</a>
            </div>
        </div>

        <!-- Stats -->
        <div class="stats-grid">
            <div class="stat-card">
                <div class="number"><%= keys.length %></div>
                <div class="label">Total API Keys</div>
            </div>
            <div class="stat-card">
                <div class="number"><%= totalHits %></div>
                <div class="label">Total Hits</div>
            </div>
            <div class="stat-card">
                <div class="number"><%= active %></div>
                <div class="label">Active Keys</div>
            </div>
            <div class="stat-card">
                <div class="number"><%= apis.length %></div>
                <div class="label">Available APIs</div>
            </div>
        </div>

        <!-- Master API Card -->
        <div class="master-api-card" id="masterApiCard">
            <div class="card-title">🌐 API SYSTEM</div>
            <div class="toggle-row">
                <div class="toggle-switch <%= settings && settings.master_api == 1 ? 'active' : '' %>" 
                     id="masterToggle" onclick="toggleMasterApi()">
                    <div class="slider"></div>
                </div>
                <span class="toggle-status <%= settings && settings.master_api == 1 ? 'on' : 'off' %>" id="masterStatus">
                    <%= settings && settings.master_api == 1 ? '🟢 ONLINE' : '🔴 OFFLINE' %>
                </span>
            </div>
            <textarea id="maintenanceMessage" placeholder="Maintenance message..."><%= settings && settings.maintenance_message ? settings.maintenance_message : 'API is currently under maintenance.' %></textarea>
            <button class="btn-save" onclick="saveMasterSettings()">💾 Save Settings</button>
            <div id="masterSaveStatus" style="margin-top:10px;font-size:13px;color:#7bff9e;"></div>
        </div>

        <!-- Generate Key Section -->
        <div style="background:#141e2b;border-radius:12px;padding:20px;border:1px solid #1e2a3a;margin-bottom:30px;">
            <h2 style="color:#00d4ff;margin-bottom:15px;">➕ Generate New API Key</h2>
            <form action="/admin/generate-key" method="POST" id="generateKeyForm">
                <div style="display:grid;grid-template-columns:1fr 1fr;gap:15px;">
                    <div>
                        <label style="color:#8899aa;font-size:13px;">Key Name *</label>
                        <input type="text" name="name" required style="width:100%;padding:10px;background:#0a0e1a;border:1px solid #1e2a3a;border-radius:6px;color:#e0e0e0;">
                    </div>
                    <div>
                        <label style="color:#8899aa;font-size:13px;">Custom Key</label>
                        <div style="display:flex;gap:10px;align-items:center;">
                            <input type="checkbox" name="enable_custom" id="enableCustom" onchange="toggleCustomKey()">
                            <label for="enableCustom" style="font-weight:normal;color:#e0e0e0;">Enable Custom</label>
                        </div>
                        <input type="text" name="custom_key" id="customKeyInput" disabled style="width:100%;padding:10px;background:#0a0e1a;border:1px solid #1e2a3a;border-radius:6px;color:#e0e0e0;margin-top:5px;" placeholder="e.g., MY_PREMIUM_KEY">
                    </div>
                </div>
                <div style="display:grid;grid-template-columns:1fr 1fr;gap:15px;margin-top:15px;">
                    <div>
                        <label style="color:#8899aa;font-size:13px;">Expiry</label>
                        <select name="expiry" id="expirySelect" onchange="toggleCustomExpiry()" style="width:100%;padding:10px;background:#0a0e1a;border:1px solid #1e2a3a;border-radius:6px;color:#e0e0e0;">
                            <option value="3d">3 Days</option>
                            <option value="7d" selected>7 Days</option>
                            <option value="30d">30 Days</option>
                            <option value="custom">Custom</option>
                        </select>
                    </div>
                    <div id="customExpiryContainer" style="display:none;">
                        <label style="color:#8899aa;font-size:13px;">Custom Date & Time</label>
                        <input type="date" name="custom_expiry_date" id="customExpiryDate" style="width:100%;padding:10px;background:#0a0e1a;border:1px solid #1e2a3a;border-radius:6px;color:#e0e0e0;">
                        <input type="time" name="custom_expiry_time" id="customExpiryTime" style="width:100%;padding:10px;background:#0a0e1a;border:1px solid #1e2a3a;border-radius:6px;color:#e0e0e0;margin-top:5px;">
                    </div>
                </div>
                <div style="display:grid;grid-template-columns:1fr 1fr;gap:15px;margin-top:15px;">
                    <div>
                        <label style="color:#8899aa;font-size:13px;">Unlimited Hits</label>
                        <div style="display:flex;gap:10px;align-items:center;padding:10px 0;">
                            <input type="checkbox" name="unlimited_hits" id="unlimitedHits" onchange="toggleRateLimits()">
                            <label for="unlimitedHits" style="font-weight:normal;color:#e0e0e0;">Enable Unlimited</label>
                        </div>
                    </div>
                    <div>
                        <label style="color:#8899aa;font-size:13px;">Key Note</label>
                        <div style="display:flex;gap:10px;align-items:center;padding:5px 0;">
                            <input type="checkbox" name="note_enabled" id="noteEnabled" onchange="toggleKeyNote()">
                            <label for="noteEnabled" style="font-weight:normal;color:#e0e0e0;">Enable Note</label>
                        </div>
                        <input type="text" name="key_note" id="keyNoteInput" disabled style="width:100%;padding:10px;background:#0a0e1a;border:1px solid #1e2a3a;border-radius:6px;color:#e0e0e0;margin-top:5px;" placeholder="e.g., Premium Customer">
                    </div>
                </div>
                <div id="rateLimitContainer" style="display:grid;grid-template-columns:1fr 1fr 1fr;gap:15px;margin-top:15px;">
                    <div>
                        <label style="color:#8899aa;font-size:13px;">Rate Limit / Day</label>
                        <input type="number" name="rate_limit_per_day" value="100" style="width:100%;padding:10px;background:#0a0e1a;border:1px solid #1e2a3a;border-radius:6px;color:#e0e0e0;">
                    </div>
                    <div>
                        <label style="color:#8899aa;font-size:13px;">Rate Limit / Hour</label>
                        <input type="number" name="rate_limit_per_hour" value="20" style="width:100%;padding:10px;background:#0a0e1a;border:1px solid #1e2a3a;border-radius:6px;color:#e0e0e0;">
                    </div>
                    <div>
                        <label style="color:#8899aa;font-size:13px;">Rate Limit / Minute</label>
                        <input type="number" name="rate_limit_per_minute" value="5" style="width:100%;padding:10px;background:#0a0e1a;border:1px solid #1e2a3a;border-radius:6px;color:#e0e0e0;">
                    </div>
                </div>
                <div style="margin-top:15px;">
                    <label style="color:#8899aa;font-size:13px;">Allowed APIs</label>
                    <div class="checkbox-group" style="display:flex;flex-wrap:wrap;gap:8px;padding:10px 0;">
                        <label style="display:flex;align-items:center;gap:5px;color:#e0e0e0;font-weight:normal;cursor:pointer;">
                            <input type="checkbox" name="selected_apis" value="all" checked onchange="handleSelectAll(this)"> All
                        </label>
                        <% apis.forEach(api => { %>
                            <label style="display:flex;align-items:center;gap:5px;color:#e0e0e0;font-weight:normal;cursor:pointer;">
                                <input type="checkbox" name="selected_apis" value="<%= api.name %>" class="api-checkbox"> <%= api.display_name %>
                            </label>
                        <% }); %>
                    </div>
                </div>
                <button type="submit" style="margin-top:15px;background:linear-gradient(135deg,#00d4ff,#7b2ffc);color:white;border:none;padding:12px 30px;border-radius:8px;cursor:pointer;font-weight:bold;width:100%;transition:0.3s;" 
                        onmouseover="this.style.opacity='0.8'" onmouseout="this.style.opacity='1'">
                    🔑 Generate Key
                </button>
            </form>
        </div>

        <!-- Key Cards -->
        <h2 style="color:#00d4ff;margin:20px 0;">🔑 API Keys</h2>
        <div class="key-grid" id="keyGrid">
            <% if (keys && keys.length > 0) { %>
                <% keys.forEach(key => { 
                    const isExpired = key.expires_at && new Date(key.expires_at) < new Date();
                    const status = isExpired ? 'expired' : (key.status || 'active');
                    let allowedApis = [];
                    try { allowedApis = JSON.parse(key.allowed_apis || '["all"]'); } catch(e) { allowedApis = ['all']; }
                %>
                    <div class="key-card" id="key-<%= key.id %>" data-expires="<%= key.expires_at %>">
                        <div class="key-name"><%= key.name || 'Unnamed' %></div>
                        <div class="key-value"><%= key.key %></div>
                        <div>
                            <span class="status-badge <%= status %>"><%= status.toUpperCase() %></span>
                        </div>
                        <div class="info-row">
                            <span class="label">Created</span>
                            <span class="value"><%= key.created_at ? new Date(key.created_at).toLocaleString() : 'N/A' %></span>
                        </div>
                        <div class="info-row">
                            <span class="label">Expires</span>
                            <span class="value"><%= key.expires_at ? new Date(key.expires_at).toLocaleString() : 'Never' %></span>
                        </div>
                        <div class="timer" id="timer-<%= key.id %>">
                            <%= key.expires_at ? 'Loading...' : '🔵 Never Expires' %>
                        </div>
                        <div class="badges">
                            <% if (key.unlimited_hits == 1) { %>
                                <span class="badge-item unlimited">🚀 Unlimited</span>
                            <% } %>
                            <% if (key.note_enabled == 1 && key.key_note) { %>
                                <span class="badge-item note">📝 <%= key.key_note %></span>
                            <% } %>
                            <span class="badge-item" style="background:#1e2a3a;color:#8899aa;">
                                APIs: <%= allowedApis.includes('all') ? 'All' : allowedApis.length %>
                            </span>
                        </div>
                        <div class="actions">
                            <button class="btn-edit" onclick="openEditModal(<%= key.id %>, '<%= key.name %>', '<%= key.key %>', '<%= key.expires_at %>', <%= key.unlimited_hits %>, '<%= key.status %>', '<%= key.allowed_apis %>', <%= key.note_enabled %>, '<%= key.key_note || '' %>')">✏️ Edit</button>
                            <button class="btn-toggle <%= status === 'active' ? 'active-btn' : '' %>" onclick="toggleKeyStatus(<%= key.id %>, '<%= status %>')">
                                <%= status === 'active' ? '✅ Active' : '🔴 Disable' %>
                            </button>
                            <button class="btn-delete" onclick="deleteKey(<%= key.id %>)">🗑️ Delete</button>
                        </div>
                    </div>
                <% }); %>
            <% } else { %>
                <p style="color:#8899aa;text-align:center;padding:40px;">No API keys generated yet.</p>
            <% } %>
        </div>
    </div>

    <!-- Edit Modal -->
    <div class="modal" id="editModal">
        <div class="modal-content">
            <h2>✏️ Edit API Key</h2>
            <form id="editKeyForm">
                <input type="hidden" name="key_id" id="editKeyId">
                <div class="form-group">
                    <label>Key Name</label>
                    <input type="text" name="name" id="editName" required>
                </div>
                <div class="form-group">
                    <label>Expiry</label>
                    <select name="expiry" id="editExpiry" onchange="toggleEditCustomExpiry()">
                        <option value="3d">3 Days</option>
                        <option value="7d">7 Days</option>
                        <option value="30d">30 Days</option>
                        <option value="custom">Custom</option>
                    </select>
                </div>
                <div id="editCustomExpiryContainer" style="display:none;" class="form-group">
                    <label>Custom Date & Time</label>
                    <input type="date" name="custom_expiry_date" id="editCustomDate">
                    <input type="time" name="custom_expiry_time" id="editCustomTime" style="margin-top:5px;">
                </div>
                <div class="form-group">
                    <label>Status</label>
                    <select name="status" id="editStatus">
                        <option value="active">Active</option>
                        <option value="disabled">Disabled</option>
                        <option value="expired">Expired</option>
                    </select>
                </div>
                <div class="form-group">
                    <label>Unlimited Hits</label>
                    <input type="checkbox" name="unlimited_hits" id="editUnlimited" onchange="toggleEditRateLimits()">
                </div>
                <div id="editRateLimitContainer">
                    <div class="form-row">
                        <div>
                            <label>Rate Limit / Day</label>
                            <input type="number" name="rate_limit_per_day" id="editRateDay" value="100">
                        </div>
                        <div>
                            <label>Rate Limit / Hour</label>
                            <input type="number" name="rate_limit_per_hour" id="editRateHour" value="20">
                        </div>
                        <div>
                            <label>Rate Limit / Minute</label>
                            <input type="number" name="rate_limit_per_minute" id="editRateMin" value="5">
                        </div>
                    </div>
                </div>
                <div class="form-group">
                    <label>
                        <input type="checkbox" name="note_enabled" id="editNoteEnabled" onchange="toggleEditKeyNote()"> Enable Note
                    </label>
                    <input type="text" name="key_note" id="editKeyNote" placeholder="e.g., Premium Customer" style="margin-top:5px;">
                </div>
                <div class="form-group">
                    <label>Allowed APIs</label>
                    <div class="checkbox-group">
                        <label><input type="checkbox" value="all" id="editSelectAll" onchange="handleEditSelectAll()"> All</label>
                        <% apis.forEach(api => { %>
                            <label><input type="checkbox" name="selected_apis" value="<%= api.name %>" class="edit-api-checkbox"> <%= api.display_name %></label>
                        <% }); %>
                    </div>
                </div>
                <button type="submit" class="btn-submit">💾 Save Changes</button>
                <button type="button" class="btn-close" onclick="closeEditModal()">❌ Cancel</button>
            </form>
        </div>
    </div>

    <script>
        // ============ MASTER API TOGGLE ============
        function toggleMasterApi() {
            const toggle = document.getElementById('masterToggle');
            const status = document.getElementById('masterStatus');
            const isActive = toggle.classList.toggle('active');
            status.textContent = isActive ? '🟢 ONLINE' : '🔴 OFFLINE';
            status.className = 'toggle-status ' + (isActive ? 'on' : 'off');
        }

        async function saveMasterSettings() {
            const toggle = document.getElementById('masterToggle');
            const message = document.getElementById('maintenanceMessage').value;
            const masterApi = toggle.classList.contains('active') ? 'on' : 'off';
            
            const statusDiv = document.getElementById('masterSaveStatus');
            statusDiv.textContent = '⏳ Saving...';
            
            try {
                const response = await fetch('/admin/update-settings', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ master_api: masterApi, maintenance_message: message })
                });
                const data = await response.json();
                if (data.success) {
                    statusDiv.textContent = '✅ Settings saved successfully!';
                    statusDiv.style.color = '#7bff9e';
                } else {
                    statusDiv.textContent = '❌ Failed to save settings';
                    statusDiv.style.color = '#ff4444';
                }
            } catch(e) {
                statusDiv.textContent = '❌ Error: ' + e.message;
                statusDiv.style.color = '#ff4444';
            }
        }

        // ============ GENERATE KEY FORM HELPERS ============
        function toggleCustomKey() {
            const checkbox = document.getElementById('enableCustom');
            const input = document.getElementById('customKeyInput');
            input.disabled = !checkbox.checked;
            if (!checkbox.checked) input.value = '';
        }

        function toggleCustomExpiry() {
            const select = document.getElementById('expirySelect');
            const container = document.getElementById('customExpiryContainer');
            container.style.display = select.value === 'custom' ? 'block' : 'none';
        }

        function toggleRateLimits() {
            const checkbox = document.getElementById('unlimitedHits');
            const container = document.getElementById('rateLimitContainer');
            container.style.display = checkbox.checked ? 'none' : 'grid';
        }

        function toggleKeyNote() {
            const checkbox = document.getElementById('noteEnabled');
            const input = document.getElementById('keyNoteInput');
            input.disabled = !checkbox.checked;
            if (!checkbox.checked) input.value = '';
        }

        function handleSelectAll(selectAll) {
            const checkboxes = document.querySelectorAll('.api-checkbox');
            checkboxes.forEach(cb => cb.checked = selectAll.checked);
        }

        // ============ EDIT KEY MODAL ============
        function openEditModal(id, name, key, expiresAt, unlimited, status, allowedApis, noteEnabled, keyNote) {
            document.getElementById('editKeyId').value = id;
            document.getElementById('editName').value = name || '';
            document.getElementById('editStatus').value = status || 'active';
            document.getElementById('editUnlimited').checked = unlimited == 1;
            
            if (noteEnabled == 1) {
                document.getElementById('editNoteEnabled').checked = true;
                document.getElementById('editKeyNote').disabled = false;
                document.getElementById('editKeyNote').value = keyNote || '';
            } else {
                document.getElementById('editNoteEnabled').checked = false;
                document.getElementById('editKeyNote').disabled = true;
                document.getElementById('editKeyNote').value = '';
            }
            
            // Set expiry
            if (expiresAt) {
                const date = new Date(expiresAt);
                const now = new Date();
                const diffDays = Math.ceil((date - now) / (1000 * 60 * 60 * 24));
                let expiryOption = 'custom';
                if (diffDays <= 3) expiryOption = '3d';
                else if (diffDays <= 7) expiryOption = '7d';
                else if (diffDays <= 30) expiryOption = '30d';
                document.getElementById('editExpiry').value = expiryOption;
                
                if (expiryOption === 'custom') {
                    document.getElementById('editCustomDate').value = date.toISOString().split('T')[0];
                    document.getElementById('editCustomTime').value = date.toTimeString().slice(0,5);
                    document.getElementById('editCustomExpiryContainer').style.display = 'block';
                }
            }
            
            // Set allowed APIs
            try {
                const apis = JSON.parse(allowedApis || '["all"]');
                const checkboxes = document.querySelectorAll('.edit-api-checkbox');
                checkboxes.forEach(cb => cb.checked = apis.includes('all') || apis.includes(cb.value));
                document.getElementById('editSelectAll').checked = apis.includes('all');
            } catch(e) {}
            
            // Set rate limits
            document.getElementById('editRateDay').value = 100;
            document.getElementById('editRateHour').value = 20;
            document.getElementById('editRateMin').value = 5;
            
            toggleEditRateLimits();
            document.getElementById('editModal').classList.add('active');
        }

        function closeEditModal() {
            document.getElementById('editModal').classList.remove('active');
        }

        function toggleEditCustomExpiry() {
            const select = document.getElementById('editExpiry');
            const container = document.getElementById('editCustomExpiryContainer');
            container.style.display = select.value === 'custom' ? 'block' : 'none';
        }

        function toggleEditRateLimits() {
            const checkbox = document.getElementById('editUnlimited');
            const container = document.getElementById('editRateLimitContainer');
            container.style.display = checkbox.checked ? 'none' : 'block';
        }

        function toggleEditKeyNote() {
            const checkbox = document.getElementById('editNoteEnabled');
            const input = document.getElementById('editKeyNote');
            input.disabled = !checkbox.checked;
            if (!checkbox.checked) input.value = '';
        }

        function handleEditSelectAll() {
            const selectAll = document.getElementById('editSelectAll');
            const checkboxes = document.querySelectorAll('.edit-api-checkbox');
            checkboxes.forEach(cb => cb.checked = selectAll.checked);
        }

        // Edit form submission
        document.getElementById('editKeyForm').addEventListener('submit', async function(e) {
            e.preventDefault();
            const formData = new FormData(this);
            const data = {};
            formData.forEach((value, key) => {
                if (key === 'selected_apis') {
                    if (!data[key]) data[key] = [];
                    data[key].push(value);
                } else {
                    data[key] = value;
                }
            });
            
            try {
                const response = await fetch('/admin/edit-key', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(data)
                });
                const result = await response.json();
                if (result.success) {
                    closeEditModal();
                    location.reload();
                } else {
                    alert('Failed to update key: ' + (result.error || 'Unknown error'));
                }
            } catch(e) {
                alert('Error: ' + e.message);
            }
        });

        // ============ KEY ACTIONS ============
        async function toggleKeyStatus(id, currentStatus) {
            const newStatus = currentStatus === 'active' ? 'disabled' : 'active';
            if (!confirm(`Set key to ${newStatus}?`)) return;
            
            try {
                const response = await fetch('/admin/toggle-status', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                    body: `id=${id}&status=${newStatus}`
                });
                location.reload();
            } catch(e) {
                alert('Error: ' + e.message);
            }
        }

        async function deleteKey(id) {
            if (!confirm('Are you sure you want to delete this key?')) return;
            try {
                const response = await fetch('/admin/delete-key', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                    body: `id=${id}`
                });
                location.reload();
            } catch(e) {
                alert('Error: ' + e.message);
            }
        }

        // ============ COUNTDOWN TIMERS ============
        function updateTimers() {
            const keyCards = document.querySelectorAll('.key-card[data-expires]');
            const now = new Date();
            
            keyCards.forEach(card => {
                const expiresAt = card.dataset.expires;
                if (!expiresAt) return;
                
                const expiry = new Date(expiresAt);
                const diff = expiry - now;
                const timerEl = card.querySelector('.timer');
                
                if (diff <= 0) {
                    timerEl.textContent = '🔴 EXPIRED';
                    timerEl.className = 'timer expired';
                    // Update status badge
                    const badge = card.querySelector('.status-badge');
                    if (badge) {
                        badge.textContent = 'EXPIRED';
                        badge.className = 'status-badge expired';
                    }
                    return;
                }
                
                const days = Math.floor(diff / (1000 * 60 * 60 * 24));
                const hours = Math.floor((diff % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60));
                const minutes = Math.floor((diff % (1000 * 60 * 60)) / (1000 * 60));
                const seconds = Math.floor((diff % (1000 * 60)) / 1000);
                
                let timerText = '';
                if (days > 0) timerText += `${days}d `;
                if (hours > 0 || days > 0) timerText += `${hours}h `;
                timerText += `${minutes}m ${seconds}s`;
                
                timerEl.textContent = `⏳ ${timerText}`;
                timerEl.className = 'timer';
            });
        }

        // Update timers every second
        setInterval(updateTimers, 1000);
        updateTimers();

        // ============ KEYBOARD SHORTCUTS ============
        document.addEventListener('keydown', (e) => {
            if (e.key === 'Escape') closeEditModal();
        });

        // Close modal on outside click
        document.getElementById('editModal').addEventListener('click', function(e) {
            if (e.target === this) closeEditModal();
        });
    </script>
</body>
</html>
