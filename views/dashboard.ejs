<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Admin Dashboard - OSINT API Hub</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        /* System Font Stack for iOS feel */
        body {
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', 'Helvetica Neue', sans-serif;
            background: linear-gradient(135deg, #0f1419 0%, #1a1f2e 50%, #0f1419 100%);
            background-attachment: fixed;
            color: #f0f4f8;
            min-height: 100vh;
            position: relative;
        }

        /* Animated background gradient */
        body::before {
            content: '';
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: radial-gradient(circle at 20% 50%, rgba(0, 188, 212, 0.05) 0%, transparent 50%),
                        radial-gradient(circle at 80% 80%, rgba(124, 58, 237, 0.05) 0%, transparent 50%);
            pointer-events: none;
            z-index: -1;
        }

        .container {
            max-width: 1400px;
            margin: 0 auto;
            padding: 24px;
        }

        /* ============ HEADER ============ */
        .header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 20px 24px;
            margin-bottom: 32px;
            background: rgba(15, 20, 25, 0.4);
            backdrop-filter: blur(20px);
            border: 1px solid rgba(0, 188, 212, 0.1);
            border-radius: 20px;
            box-shadow: 0 8px 32px rgba(0, 0, 0, 0.2);
            animation: slideDown 0.6s ease-out;
        }

        @keyframes slideDown {
            from {
                opacity: 0;
                transform: translateY(-20px);
            }
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        .header h1 {
            font-size: 28px;
            font-weight: 600;
            letter-spacing: -0.5px;
            background: linear-gradient(135deg, #00bcd4 0%, #7c3aed 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
        }

        .user-info {
            display: flex;
            align-items: center;
            gap: 16px;
        }

        .user-info .badge {
            background: rgba(0, 188, 212, 0.15);
            backdrop-filter: blur(10px);
            padding: 8px 16px;
            border-radius: 12px;
            font-size: 13px;
            font-weight: 500;
            color: #00bcd4;
            border: 1px solid rgba(0, 188, 212, 0.3);
            transition: all 0.3s ease;
        }

        .user-info .badge:hover {
            background: rgba(0, 188, 212, 0.25);
            border-color: rgba(0, 188, 212, 0.5);
        }

        .btn-logout {
            background: linear-gradient(135deg, #ef4444 0%, #dc2626 100%);
            color: white;
            border: none;
            padding: 10px 24px;
            border-radius: 12px;
            cursor: pointer;
            font-weight: 600;
            font-size: 14px;
            transition: all 0.3s ease;
            box-shadow: 0 4px 15px rgba(239, 68, 68, 0.3);
        }

        .btn-logout:hover {
            transform: translateY(-2px);
            box-shadow: 0 6px 20px rgba(239, 68, 68, 0.4);
        }

        .btn-logout:active {
            transform: translateY(0);
        }

        /* ============ STATS GRID ============ */
        .stats-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
            gap: 16px;
            margin-bottom: 32px;
        }

        .stat-card {
            background: rgba(20, 30, 43, 0.5);
            backdrop-filter: blur(20px);
            padding: 24px;
            border-radius: 18px;
            border: 1px solid rgba(0, 188, 212, 0.15);
            box-shadow: 0 8px 32px rgba(0, 0, 0, 0.15);
            transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
            animation: fadeInUp 0.6s ease-out forwards;
            opacity: 0;
        }

        @keyframes fadeInUp {
            from {
                opacity: 0;
                transform: translateY(20px);
            }
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        .stat-card:nth-child(1) { animation-delay: 0.1s; }
        .stat-card:nth-child(2) { animation-delay: 0.2s; }
        .stat-card:nth-child(3) { animation-delay: 0.3s; }
        .stat-card:nth-child(4) { animation-delay: 0.4s; }

        .stat-card:hover {
            background: rgba(20, 30, 43, 0.7);
            border-color: rgba(0, 188, 212, 0.3);
            transform: translateY(-8px);
            box-shadow: 0 12px 40px rgba(0, 188, 212, 0.15);
        }

        .stat-card .number {
            font-size: 36px;
            font-weight: 700;
            letter-spacing: -1px;
            background: linear-gradient(135deg, #00bcd4 0%, #7c3aed 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
        }

        .stat-card .label {
            font-size: 13px;
            color: #94a3b8;
            margin-top: 8px;
            font-weight: 500;
            letter-spacing: 0.3px;
        }

        /* ============ MASTER API CARD ============ */
        .master-api-card {
            background: rgba(20, 30, 43, 0.5);
            backdrop-filter: blur(20px);
            border-radius: 20px;
            padding: 28px;
            border: 1px solid rgba(0, 188, 212, 0.15);
            margin-bottom: 32px;
            box-shadow: 0 8px 32px rgba(0, 0, 0, 0.15);
            animation: fadeInUp 0.6s ease-out 0.5s forwards;
            opacity: 0;
        }

        .master-api-card .card-title {
            font-size: 18px;
            font-weight: 600;
            margin-bottom: 20px;
            color: #00bcd4;
            letter-spacing: 0.2px;
        }

        .master-api-card .toggle-row {
            display: flex;
            align-items: center;
            gap: 16px;
            margin-bottom: 20px;
            flex-wrap: wrap;
        }

        /* iOS Style Toggle Switch */
        .toggle-switch {
            position: relative;
            width: 56px;
            height: 32px;
            background: rgba(148, 163, 184, 0.2);
            border-radius: 16px;
            cursor: pointer;
            transition: all 0.35s cubic-bezier(0.34, 1.56, 0.64, 1);
            border: 1px solid rgba(148, 163, 184, 0.3);
        }

        .toggle-switch.active {
            background: rgba(16, 185, 129, 0.3);
            border-color: rgba(16, 185, 129, 0.5);
        }

        .toggle-switch .slider {
            position: absolute;
            top: 3px;
            left: 3px;
            width: 26px;
            height: 26px;
            background: white;
            border-radius: 12px;
            transition: all 0.35s cubic-bezier(0.34, 1.56, 0.64, 1);
            box-shadow: 0 2px 8px rgba(0, 0, 0, 0.25);
        }

        .toggle-switch.active .slider {
            left: 27px;
            background: #10b981;
        }

        .toggle-status {
            font-weight: 600;
            font-size: 15px;
            transition: color 0.3s ease;
        }

        .toggle-status.on {
            color: #10b981;
        }

        .toggle-status.off {
            color: #ef4444;
        }

        .master-api-card textarea {
            width: 100%;
            padding: 14px 16px;
            background: rgba(15, 20, 25, 0.5);
            backdrop-filter: blur(10px);
            border: 1px solid rgba(0, 188, 212, 0.2);
            border-radius: 14px;
            color: #f0f4f8;
            font-size: 14px;
            font-family: 'Monaco', 'Menlo', monospace;
            resize: vertical;
            min-height: 80px;
            margin-bottom: 16px;
            transition: all 0.3s ease;
        }

        .master-api-card textarea:focus {
            outline: none;
            background: rgba(15, 20, 25, 0.7);
            border-color: rgba(0, 188, 212, 0.4);
            box-shadow: 0 0 0 3px rgba(0, 188, 212, 0.1);
        }

        .master-api-card .btn-save {
            background: linear-gradient(135deg, #00bcd4 0%, #7c3aed 100%);
            color: white;
            border: none;
            padding: 12px 28px;
            border-radius: 12px;
            cursor: pointer;
            font-weight: 600;
            font-size: 14px;
            transition: all 0.3s ease;
            box-shadow: 0 4px 15px rgba(0, 188, 212, 0.3);
        }

        .master-api-card .btn-save:hover {
            transform: translateY(-2px);
            box-shadow: 0 6px 20px rgba(0, 188, 212, 0.4);
        }

        .master-api-card .btn-save:active {
            transform: translateY(0);
        }

        /* ============ GENERATE KEY SECTION ============ */
        .generate-section {
            background: rgba(20, 30, 43, 0.5);
            backdrop-filter: blur(20px);
            border-radius: 20px;
            padding: 28px;
            border: 1px solid rgba(0, 188, 212, 0.15);
            margin-bottom: 32px;
            box-shadow: 0 8px 32px rgba(0, 0, 0, 0.15);
            animation: fadeInUp 0.6s ease-out 0.6s forwards;
            opacity: 0;
        }

        .generate-section h2 {
            color: #00bcd4;
            margin-bottom: 20px;
            font-size: 18px;
            font-weight: 600;
            letter-spacing: 0.2px;
        }

        .form-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 16px;
        }

        .form-group {
            display: flex;
            flex-direction: column;
        }

        .form-group label {
            color: #94a3b8;
            font-size: 13px;
            font-weight: 600;
            margin-bottom: 8px;
            letter-spacing: 0.3px;
        }

        .form-group input,
        .form-group select,
        .form-group textarea {
            padding: 12px 14px;
            background: rgba(15, 20, 25, 0.5);
            backdrop-filter: blur(10px);
            border: 1px solid rgba(0, 188, 212, 0.2);
            border-radius: 12px;
            color: #f0f4f8;
            font-size: 14px;
            font-family: inherit;
            transition: all 0.3s ease;
        }

        .form-group input:focus,
        .form-group select:focus,
        .form-group textarea:focus {
            outline: none;
            background: rgba(15, 20, 25, 0.7);
            border-color: rgba(0, 188, 212, 0.4);
            box-shadow: 0 0 0 3px rgba(0, 188, 212, 0.1);
        }

        .checkbox-group {
            display: flex;
            gap: 12px;
            flex-wrap: wrap;
            padding: 12px 0;
        }

        .checkbox-group label {
            display: flex;
            align-items: center;
            gap: 6px;
            font-weight: normal;
            color: #e2e8f0;
            cursor: pointer;
            transition: color 0.3s ease;
        }

        .checkbox-group label:hover {
            color: #00bcd4;
        }

        .checkbox-group input[type="checkbox"] {
            width: 18px;
            height: 18px;
            cursor: pointer;
            accent-color: #00bcd4;
        }

        .btn-generate {
            margin-top: 16px;
            background: linear-gradient(135deg, #00bcd4 0%, #7c3aed 100%);
            color: white;
            border: none;
            padding: 14px 28px;
            border-radius: 12px;
            cursor: pointer;
            font-weight: 600;
            font-size: 15px;
            width: 100%;
            transition: all 0.3s ease;
            box-shadow: 0 4px 15px rgba(0, 188, 212, 0.3);
        }

        .btn-generate:hover {
            transform: translateY(-2px);
            box-shadow: 0 6px 20px rgba(0, 188, 212, 0.4);
        }

        .btn-generate:active {
            transform: translateY(0);
        }

        /* ============ KEY CARDS ============ */
        .keys-header {
            color: #00bcd4;
            margin: 40px 0 20px 0;
            font-size: 18px;
            font-weight: 600;
            letter-spacing: 0.2px;
        }

        .key-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(420px, 1fr));
            gap: 20px;
            animation: fadeInUp 0.6s ease-out 0.7s forwards;
            opacity: 0;
        }

        .key-card {
            background: rgba(20, 30, 43, 0.5);
            backdrop-filter: blur(20px);
            border-radius: 18px;
            padding: 24px;
            border: 1px solid rgba(0, 188, 212, 0.15);
            position: relative;
            transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
            box-shadow: 0 8px 32px rgba(0, 0, 0, 0.15);
        }

        .key-card:hover {
            border-color: rgba(0, 188, 212, 0.3);
            background: rgba(20, 30, 43, 0.7);
            transform: translateY(-8px);
            box-shadow: 0 12px 40px rgba(0, 188, 212, 0.2);
        }

        .key-card .key-name {
            font-size: 16px;
            font-weight: 600;
            color: #00bcd4;
            margin-bottom: 12px;
            letter-spacing: 0.2px;
        }

        .key-card .key-value {
            font-family: 'Monaco', 'Menlo', monospace;
            background: rgba(15, 20, 25, 0.6);
            backdrop-filter: blur(10px);
            padding: 10px 12px;
            border-radius: 10px;
            margin: 8px 0 12px;
            font-size: 12px;
            word-break: break-all;
            color: #10b981;
            border: 1px solid rgba(16, 185, 129, 0.2);
            transition: all 0.3s ease;
        }

        .key-card .key-value:hover {
            background: rgba(15, 20, 25, 0.8);
            border-color: rgba(16, 185, 129, 0.4);
        }

        .status-badge {
            display: inline-block;
            padding: 5px 14px;
            border-radius: 8px;
            font-size: 11px;
            font-weight: 600;
            letter-spacing: 0.4px;
            transition: all 0.3s ease;
        }

        .status-badge.active {
            background: rgba(16, 185, 129, 0.25);
            color: #10b981;
            border: 1px solid rgba(16, 185, 129, 0.4);
        }

        .status-badge.disabled {
            background: rgba(239, 68, 68, 0.25);
            color: #ef4444;
            border: 1px solid rgba(239, 68, 68, 0.4);
        }

        .status-badge.expired {
            background: rgba(249, 115, 22, 0.25);
            color: #f97316;
            border: 1px solid rgba(249, 115, 22, 0.4);
        }

        .key-card .info-row {
            display: flex;
            justify-content: space-between;
            padding: 10px 0;
            font-size: 13px;
            border-bottom: 1px solid rgba(0, 188, 212, 0.08);
        }

        .key-card .info-row .label {
            color: #94a3b8;
            font-weight: 500;
        }

        .key-card .info-row .value {
            color: #e2e8f0;
            font-weight: 500;
        }

        .key-card .timer {
            font-family: 'Monaco', 'Menlo', monospace;
            font-size: 15px;
            font-weight: 600;
            color: #00bcd4;
            padding: 10px 12px;
            background: rgba(0, 188, 212, 0.1);
            border-radius: 10px;
            text-align: center;
            margin: 12px 0;
            border: 1px solid rgba(0, 188, 212, 0.2);
            transition: all 0.3s ease;
        }

        .key-card .timer.expired {
            color: #ef4444;
            background: rgba(239, 68, 68, 0.1);
            border-color: rgba(239, 68, 68, 0.2);
        }

        .key-card .badges {
            display: flex;
            gap: 8px;
            flex-wrap: wrap;
            margin: 12px 0;
        }

        .badge-item {
            padding: 4px 12px;
            border-radius: 8px;
            font-size: 11px;
            font-weight: 600;
            letter-spacing: 0.3px;
            border: 1px solid;
        }

        .badge-item.unlimited {
            background: rgba(16, 185, 129, 0.15);
            color: #10b981;
            border-color: rgba(16, 185, 129, 0.3);
        }

        .badge-item.note {
            background: rgba(245, 158, 11, 0.15);
            color: #f59e0b;
            border-color: rgba(245, 158, 11, 0.3);
        }

        .badge-item.api {
            background: rgba(0, 188, 212, 0.15);
            color: #00bcd4;
            border-color: rgba(0, 188, 212, 0.3);
        }

        .key-card .actions {
            display: flex;
            gap: 8px;
            margin-top: 16px;
            flex-wrap: wrap;
        }

        .key-card .actions button {
            padding: 8px 16px;
            border: none;
            border-radius: 10px;
            cursor: pointer;
            font-size: 12px;
            font-weight: 600;
            transition: all 0.3s ease;
            flex: 1;
            min-width: 100px;
        }

        .btn-edit {
            background: linear-gradient(135deg, #3b82f6 0%, #1d4ed8 100%);
            color: white;
            box-shadow: 0 4px 12px rgba(59, 130, 246, 0.25);
        }

        .btn-edit:hover {
            transform: translateY(-2px);
            box-shadow: 0 6px 16px rgba(59, 130, 246, 0.35);
        }

        .btn-delete {
            background: linear-gradient(135deg, #ef4444 0%, #dc2626 100%);
            color: white;
            box-shadow: 0 4px 12px rgba(239, 68, 68, 0.25);
        }

        .btn-delete:hover {
            transform: translateY(-2px);
            box-shadow: 0 6px 16px rgba(239, 68, 68, 0.35);
        }

        .btn-toggle {
            background: linear-gradient(135deg, #64748b 0%, #475569 100%);
            color: white;
            box-shadow: 0 4px 12px rgba(100, 116, 139, 0.25);
        }

        .btn-toggle.active-btn {
            background: linear-gradient(135deg, #10b981 0%, #059669 100%);
            box-shadow: 0 4px 12px rgba(16, 185, 129, 0.35);
        }

        .btn-toggle:hover {
            transform: translateY(-2px);
        }

        /* ============ MODAL ============ */
        .modal {
            display: none;
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(0, 0, 0, 0.5);
            backdrop-filter: blur(8px);
            z-index: 1000;
            justify-content: center;
            align-items: center;
            animation: fadeIn 0.3s ease;
        }

        @keyframes fadeIn {
            from { opacity: 0; }
            to { opacity: 1; }
        }

        .modal.active {
            display: flex;
        }

        .modal-content {
            background: rgba(20, 30, 43, 0.8);
            backdrop-filter: blur(30px);
            border-radius: 24px;
            padding: 32px;
            max-width: 600px;
            width: 90%;
            max-height: 90vh;
            overflow-y: auto;
            border: 1px solid rgba(0, 188, 212, 0.2);
            box-shadow: 0 20px 60px rgba(0, 0, 0, 0.3);
            animation: slideUp 0.4s ease-out;
        }

        @keyframes slideUp {
            from {
                opacity: 0;
                transform: translateY(40px);
            }
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        .modal-content h2 {
            color: #00bcd4;
            margin-bottom: 24px;
            font-size: 20px;
            font-weight: 600;
            letter-spacing: 0.2px;
        }

        .modal-content .form-group {
            margin-bottom: 16px;
        }

        .modal-content .form-group label {
            display: block;
            margin-bottom: 8px;
            color: #94a3b8;
            font-size: 13px;
            font-weight: 600;
            letter-spacing: 0.3px;
        }

        .modal-content .form-group input,
        .modal-content .form-group select,
        .modal-content .form-group textarea {
            width: 100%;
            padding: 12px 14px;
            background: rgba(15, 20, 25, 0.6);
            backdrop-filter: blur(10px);
            border: 1px solid rgba(0, 188, 212, 0.2);
            border-radius: 12px;
            color: #f0f4f8;
            font-size: 14px;
            font-family: inherit;
            transition: all 0.3s ease;
        }

        .modal-content .form-group input:focus,
        .modal-content .form-group select:focus,
        .modal-content .form-group textarea:focus {
            outline: none;
            background: rgba(15, 20, 25, 0.8);
            border-color: rgba(0, 188, 212, 0.4);
            box-shadow: 0 0 0 3px rgba(0, 188, 212, 0.1);
        }

        .modal-content .btn-submit {
            background: linear-gradient(135deg, #00bcd4 0%, #7c3aed 100%);
            color: white;
            border: none;
            padding: 12px 28px;
            border-radius: 12px;
            cursor: pointer;
            font-weight: 600;
            font-size: 14px;
            width: 100%;
            transition: all 0.3s ease;
            box-shadow: 0 4px 15px rgba(0, 188, 212, 0.3);
            margin-top: 8px;
        }

        .modal-content .btn-submit:hover {
            transform: translateY(-2px);
            box-shadow: 0 6px 20px rgba(0, 188, 212, 0.4);
        }

        .modal-content .btn-close {
            background: linear-gradient(135deg, rgba(239, 68, 68, 0.3) 0%, rgba(220, 38, 38, 0.3) 100%);
            color: #ef4444;
            border: 1px solid rgba(239, 68, 68, 0.3);
            padding: 10px 20px;
            border-radius: 12px;
            cursor: pointer;
            font-weight: 600;
            font-size: 14px;
            margin-top: 8px;
            width: 100%;
            transition: all 0.3s ease;
        }

        .modal-content .btn-close:hover {
            background: linear-gradient(135deg, rgba(239, 68, 68, 0.4) 0%, rgba(220, 38, 38, 0.4) 100%);
            border-color: rgba(239, 68, 68, 0.5);
        }

        /* ============ RESPONSIVE ============ */
        @media (max-width: 768px) {
            .key-grid {
                grid-template-columns: 1fr;
            }

            .header {
                flex-direction: column;
                gap: 12px;
                text-align: center;
            }

            .form-grid {
                grid-template-columns: 1fr;
            }

            .modal-content {
                padding: 24px;
            }

            .container {
                padding: 16px;
            }
        }

        /* ============ UTILITIES ============ */
        .status-text {
            font-size: 13px;
            margin-top: 10px;
            font-weight: 500;
            letter-spacing: 0.3px;
        }

        .status-text.success {
            color: #10b981;
        }

        .status-text.error {
            color: #ef4444;
        }
    </style>
</head>
<body>
    <div class="container">
        <div class="header">
            <h1>🔐 OSINT API Hub — Admin Dashboard</h1>
            <div class="user-info">
                <span class="badge">👤 <%= user.username %> (<%= user.role %>)</span>
                <a href="/logout" class="btn-logout">Logout</a>
            </div>
        </div>

        <!-- Stats -->
        <div class="stats-grid">
            <div class="stat-card">
                <div class="number"><%= keys.length %></div>
                <div class="label">Total API Keys</div>
            </div>
            <div class="stat-card">
                <div class="number"><%= totalHits %></div>
                <div class="label">Total Hits</div>
            </div>
            <div class="stat-card">
                <div class="number"><%= active %></div>
                <div class="label">Active Keys</div>
            </div>
            <div class="stat-card">
                <div class="number"><%= apis.length %></div>
                <div class="label">Available APIs</div>
            </div>
        </div>

        <!-- Master API Card -->
        <div class="master-api-card" id="masterApiCard">
            <div class="card-title">🌐 API SYSTEM</div>
            <div class="toggle-row">
                <div class="toggle-switch <%= settings && settings.master_api == 1 ? 'active' : '' %>" 
                     id="masterToggle" onclick="toggleMasterApi()">
                    <div class="slider"></div>
                </div>
                <span class="toggle-status <%= settings && settings.master_api == 1 ? 'on' : 'off' %>" id="masterStatus">
                    <%= settings && settings.master_api == 1 ? '🟢 ONLINE' : '🔴 OFFLINE' %>
                </span>
            </div>
            <textarea id="maintenanceMessage" placeholder="Maintenance message..."><%= settings && settings.maintenance_message ? settings.maintenance_message : 'API is currently under maintenance.' %></textarea>
            <button class="btn-save" onclick="saveMasterSettings()">💾 Save Settings</button>
            <div id="masterSaveStatus" class="status-text"></div>
        </div>

        <!-- Generate Key Section -->
        <div class="generate-section">
            <h2>➕ Generate New API Key</h2>
            <form action="/admin/generate-key" method="POST" id="generateKeyForm">
                <div class="form-grid">
                    <div class="form-group">
                        <label>Key Name *</label>
                        <input type="text" name="name" required>
                    </div>
                    <div class="form-group">
                        <label>Custom Key</label>
                        <div style="display:flex;gap:10px;align-items:center;">
                            <input type="checkbox" name="enable_custom" id="enableCustom" onchange="toggleCustomKey()">
                            <label for="enableCustom" style="font-weight:normal;color:#e2e8f0;margin:0;">Enable Custom</label>
                        </div>
                        <input type="text" name="custom_key" id="customKeyInput" disabled placeholder="e.g., MY_PREMIUM_KEY" style="margin-top:8px;">
                    </div>
                </div>
                <div class="form-grid" style="margin-top:12px;">
                    <div class="form-group">
                        <label>Expiry</label>
                        <select name="expiry" id="expirySelect" onchange="toggleCustomExpiry()">
                            <option value="3d">3 Days</option>
                            <option value="7d" selected>7 Days</option>
                            <option value="30d">30 Days</option>
                            <option value="custom">Custom</option>
                        </select>
                    </div>
                    <div id="customExpiryContainer" style="display:none;">
                        <label style="color:#94a3b8;font-size:13px;font-weight:600;margin-bottom:8px;display:block;">Custom Date & Time</label>
                        <input type="date" name="custom_expiry_date" id="customExpiryDate">
                        <input type="time" name="custom_expiry_time" id="customExpiryTime" style="margin-top:8px;">
                    </div>
                </div>
                <div class="form-grid" style="margin-top:12px;">
                    <div class="form-group">
                        <label>Unlimited Hits</label>
                        <div style="display:flex;gap:10px;align-items:center;padding:8px 0;">
                            <input type="checkbox" name="unlimited_hits" id="unlimitedHits" onchange="toggleRateLimits()">
                            <label for="unlimitedHits" style="font-weight:normal;color:#e2e8f0;margin:0;">Enable Unlimited</label>
                        </div>
                    </div>
                    <div class="form-group">
                        <label>Key Note</label>
                        <div style="display:flex;gap:10px;align-items:center;padding:8px 0;">
                            <input type="checkbox" name="note_enabled" id="noteEnabled" onchange="toggleKeyNote()">
                            <label for="noteEnabled" style="font-weight:normal;color:#e2e8f0;margin:0;">Enable Note</label>
                        </div>
                        <input type="text" name="key_note" id="keyNoteInput" disabled placeholder="e.g., Premium Customer" style="margin-top:8px;">
                    </div>
                </div>
                <div id="rateLimitContainer" style="display:grid;grid-template-columns:1fr 1fr 1fr;gap:12px;margin-top:12px;">
                    <div class="form-group">
                        <label>Rate Limit / Day</label>
                        <input type="number" name="rate_limit_per_day" value="100">
                    </div>
                    <div class="form-group">
                        <label>Rate Limit / Hour</label>
                        <input type="number" name="rate_limit_per_hour" value="20">
                    </div>
                    <div class="form-group">
                        <label>Rate Limit / Minute</label>
                        <input type="number" name="rate_limit_per_minute" value="5">
                    </div>
                </div>
                <div class="form-group" style="margin-top:12px;">
                    <label>Allowed APIs</label>
                    <div class="checkbox-group">
                        <label><input type="checkbox" name="selected_apis" value="all" checked onchange="handleSelectAll(this)"> All</label>
                        <% apis.forEach(api => { %>
                            <label><input type="checkbox" name="selected_apis" value="<%= api.name %>" class="api-checkbox"> <%= api.display_name %></label>
                        <% }); %>
                    </div>
                </div>
                <button type="submit" class="btn-generate">🔑 Generate Key</button>
            </form>
        </div>

        <!-- Key Cards -->
        <h2 class="keys-header">🔑 API Keys</h2>
        <div class="key-grid" id="keyGrid">
            <% if (keys && keys.length > 0) { %>
                <% keys.forEach(key => { 
                    const isExpired = key.expires_at && new Date(key.expires_at) < new Date();
                    const status = isExpired ? 'expired' : (key.status || 'active');
                    let allowedApis = [];
                    try { allowedApis = JSON.parse(key.allowed_apis || '["all"]'); } catch(e) { allowedApis = ['all']; }
                %>
                    <div class="key-card" id="key-<%= key.id %>" data-expires="<%= key.expires_at %>">
                        <div class="key-name"><%= key.name || 'Unnamed' %></div>
                        <div class="key-value"><%= key.key %></div>
                        <div>
                            <span class="status-badge <%= status %>"><%= status.toUpperCase() %></span>
                        </div>
                        <div class="info-row">
                            <span class="label">Created</span>
                            <span class="value"><%= key.created_at ? new Date(key.created_at).toLocaleString() : 'N/A' %></span>
                        </div>
                        <div class="info-row">
                            <span class="label">Expires</span>
                            <span class="value"><%= key.expires_at ? new Date(key.expires_at).toLocaleString() : 'Never' %></span>
                        </div>
                        <div class="timer" id="timer-<%= key.id %>">
                            <%= key.expires_at ? 'Loading...' : '🔵 Never Expires' %>
                        </div>
                        <div class="badges">
                            <% if (key.unlimited_hits == 1) { %>
                                <span class="badge-item unlimited">🚀 Unlimited</span>
                            <% } %>
                            <% if (key.note_enabled == 1 && key.key_note) { %>
                                <span class="badge-item note">📝 <%= key.key_note %></span>
                            <% } %>
                            <span class="badge-item api">
                                APIs: <%= allowedApis.includes('all') ? 'All' : allowedApis.length %>
                            </span>
                        </div>
                        <div class="actions">
                            <button class="btn-edit" onclick="openEditModal(<%= key.id %>, '<%= key.name %>', '<%= key.key %>', '<%= key.expires_at %>', <%= key.unlimited_hits %>, '<%= key.status %>', '<%= key.allowed_apis %>', <%= key.note_enabled %>, '<%= key.key_note || '' %>')">✏️ Edit</button>
                            <button class="btn-toggle <%= status === 'active' ? 'active-btn' : '' %>" onclick="toggleKeyStatus(<%= key.id %>, '<%= status %>')">
                                <%= status === 'active' ? '✅ Active' : '🔴 Disable' %>
                            </button>
                            <button class="btn-delete" onclick="deleteKey(<%= key.id %>)">🗑️ Delete</button>
                        </div>
                    </div>
                <% }); %>
            <% } else { %>
                <p style="color:#94a3b8;text-align:center;padding:60px 20px;grid-column:1/-1;">No API keys generated yet. Create your first key to get started.</p>
            <% } %>
        </div>
    </div>

    <!-- Edit Modal -->
    <div class="modal" id="editModal">
        <div class="modal-content">
            <h2>✏️ Edit API Key</h2>
            <form id="editKeyForm">
                <input type="hidden" name="key_id" id="editKeyId">
                <div class="form-group">
                    <label>Key Name</label>
                    <input type="text" name="name" id="editName" required>
                </div>
                <div class="form-group">
                    <label>Expiry</label>
                    <select name="expiry" id="editExpiry" onchange="toggleEditCustomExpiry()">
                        <option value="3d">3 Days</option>
                        <option value="7d">7 Days</option>
                        <option value="30d">30 Days</option>
                        <option value="custom">Custom</option>
                    </select>
                </div>
                <div id="editCustomExpiryContainer" style="display:none;" class="form-group">
                    <label>Custom Date & Time</label>
                    <input type="date" name="custom_expiry_date" id="editCustomDate">
                    <input type="time" name="custom_expiry_time" id="editCustomTime" style="margin-top:8px;">
                </div>
                <div class="form-group">
                    <label>Status</label>
                    <select name="status" id="editStatus">
                        <option value="active">Active</option>
                        <option value="disabled">Disabled</option>
                        <option value="expired">Expired</option>
                    </select>
                </div>
                <div class="form-group">
                    <label>
                        <input type="checkbox" name="unlimited_hits" id="editUnlimited" onchange="toggleEditRateLimits()"> Unlimited Hits
                    </label>
                </div>
                <div id="editRateLimitContainer" style="display:grid;grid-template-columns:1fr 1fr 1fr;gap:12px;">
                    <div class="form-group">
                        <label>Rate Limit / Day</label>
                        <input type="number" name="rate_limit_per_day" id="editRateDay" value="100">
                    </div>
                    <div class="form-group">
                        <label>Rate Limit / Hour</label>
                        <input type="number" name="rate_limit_per_hour" id="editRateHour" value="20">
                    </div>
                    <div class="form-group">
                        <label>Rate Limit / Minute</label>
                        <input type="number" name="rate_limit_per_minute" id="editRateMin" value="5">
                    </div>
                </div>
                <div class="form-group">
                    <label>
                        <input type="checkbox" name="note_enabled" id="editNoteEnabled" onchange="toggleEditKeyNote()"> Enable Note
                    </label>
                    <input type="text" name="key_note" id="editKeyNote" placeholder="e.g., Premium Customer" style="margin-top:8px;">
                </div>
                <div class="form-group">
                    <label>Allowed APIs</label>
                    <div class="checkbox-group">
                        <label><input type="checkbox" value="all" id="editSelectAll" onchange="handleEditSelectAll()"> All</label>
                        <% apis.forEach(api => { %>
                            <label><input type="checkbox" name="selected_apis" value="<%= api.name %>" class="edit-api-checkbox"> <%= api.display_name %></label>
                        <% }); %>
                    </div>
                </div>
                <button type="submit" class="btn-submit">💾 Save Changes</button>
                <button type="button" class="btn-close" onclick="closeEditModal()">❌ Cancel</button>
            </form>
        </div>
    </div>

    <script>
        // ============ MASTER API TOGGLE ============
        function toggleMasterApi() {
            const toggle = document.getElementById('masterToggle');
            const status = document.getElementById('masterStatus');
            const isActive = toggle.classList.toggle('active');
            status.textContent = isActive ? '🟢 ONLINE' : '🔴 OFFLINE';
            status.className = 'toggle-status ' + (isActive ? 'on' : 'off');
        }

        async function saveMasterSettings() {
            const toggle = document.getElementById('masterToggle');
            const message = document.getElementById('maintenanceMessage').value;
            const masterApi = toggle.classList.contains('active') ? 'on' : 'off';
            
            const statusDiv = document.getElementById('masterSaveStatus');
            statusDiv.textContent = '⏳ Saving...';
            statusDiv.className = 'status-text';
            
            try {
                const response = await fetch('/admin/update-settings', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ master_api: masterApi, maintenance_message: message })
                });
                const data = await response.json();
                if (data.success) {
                    statusDiv.textContent = '✅ Settings saved successfully!';
                    statusDiv.className = 'status-text success';
                } else {
                    statusDiv.textContent = '❌ Failed to save settings';
                    statusDiv.className = 'status-text error';
                }
            } catch(e) {
                statusDiv.textContent = '❌ Error: ' + e.message;
                statusDiv.className = 'status-text error';
            }
        }

        // ============ GENERATE KEY FORM HELPERS ============
        function toggleCustomKey() {
            const checkbox = document.getElementById('enableCustom');
            const input = document.getElementById('customKeyInput');
            input.disabled = !checkbox.checked;
            if (!checkbox.checked) input.value = '';
        }

        function toggleCustomExpiry() {
            const select = document.getElementById('expirySelect');
            const container = document.getElementById('customExpiryContainer');
            container.style.display = select.value === 'custom' ? 'block' : 'none';
        }

        function toggleRateLimits() {
            const checkbox = document.getElementById('unlimitedHits');
            const container = document.getElementById('rateLimitContainer');
            container.style.display = checkbox.checked ? 'none' : 'grid';
        }

        function toggleKeyNote() {
            const checkbox = document.getElementById('noteEnabled');
            const input = document.getElementById('keyNoteInput');
            input.disabled = !checkbox.checked;
            if (!checkbox.checked) input.value = '';
        }

        function handleSelectAll(selectAll) {
            const checkboxes = document.querySelectorAll('.api-checkbox');
            checkboxes.forEach(cb => cb.checked = selectAll.checked);
        }

        // ============ EDIT KEY MODAL ============
        function openEditModal(id, name, key, expiresAt, unlimited, status, allowedApis, noteEnabled, keyNote) {
            document.getElementById('editKeyId').value = id;
            document.getElementById('editName').value = name || '';
            document.getElementById('editStatus').value = status || 'active';
            document.getElementById('editUnlimited').checked = unlimited == 1;
            
            if (noteEnabled == 1) {
                document.getElementById('editNoteEnabled').checked = true;
                document.getElementById('editKeyNote').disabled = false;
                document.getElementById('editKeyNote').value = keyNote || '';
            } else {
                document.getElementById('editNoteEnabled').checked = false;
                document.getElementById('editKeyNote').disabled = true;
                document.getElementById('editKeyNote').value = '';
            }
            
            // Set expiry
            if (expiresAt) {
                const date = new Date(expiresAt);
                const now = new Date();
                const diffDays = Math.ceil((date - now) / (1000 * 60 * 60 * 24));
                let expiryOption = 'custom';
                if (diffDays <= 3) expiryOption = '3d';
                else if (diffDays <= 7) expiryOption = '7d';
                else if (diffDays <= 30) expiryOption = '30d';
                document.getElementById('editExpiry').value = expiryOption;
                
                if (expiryOption === 'custom') {
                    document.getElementById('editCustomDate').value = date.toISOString().split('T')[0];
                    document.getElementById('editCustomTime').value = date.toTimeString().slice(0,5);
                    document.getElementById('editCustomExpiryContainer').style.display = 'block';
                }
            }
            
            // Set allowed APIs
            try {
                const apis = JSON.parse(allowedApis || '["all"]');
                const checkboxes = document.querySelectorAll('.edit-api-checkbox');
                checkboxes.forEach(cb => cb.checked = apis.includes('all') || apis.includes(cb.value));
                document.getElementById('editSelectAll').checked = apis.includes('all');
            } catch(e) {}
            
            // Set rate limits
            document.getElementById('editRateDay').value = 100;
            document.getElementById('editRateHour').value = 20;
            document.getElementById('editRateMin').value = 5;
            
            toggleEditRateLimits();
            document.getElementById('editModal').classList.add('active');
        }

        function closeEditModal() {
            document.getElementById('editModal').classList.remove('active');
        }

        function toggleEditCustomExpiry() {
            const select = document.getElementById('editExpiry');
            const container = document.getElementById('editCustomExpiryContainer');
            container.style.display = select.value === 'custom' ? 'block' : 'none';
        }

        function toggleEditRateLimits() {
            const checkbox = document.getElementById('editUnlimited');
            const container = document.getElementById('editRateLimitContainer');
            container.style.display = checkbox.checked ? 'none' : 'grid';
        }

        function toggleEditKeyNote() {
            const checkbox = document.getElementById('editNoteEnabled');
            const input = document.getElementById('editKeyNote');
            input.disabled = !checkbox.checked;
            if (!checkbox.checked) input.value = '';
        }

        function handleEditSelectAll() {
            const selectAll = document.getElementById('editSelectAll');
            const checkboxes = document.querySelectorAll('.edit-api-checkbox');
            checkboxes.forEach(cb => cb.checked = selectAll.checked);
        }

        // Edit form submission
        document.getElementById('editKeyForm').addEventListener('submit', async function(e) {
            e.preventDefault();
            const formData = new FormData(this);
            const data = {};
            formData.forEach((value, key) => {
                if (key === 'selected_apis') {
                    if (!data[key]) data[key] = [];
                    data[key].push(value);
                } else {
                    data[key] = value;
                }
            });
            
            try {
                const response = await fetch('/admin/edit-key', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(data)
                });
                const result = await response.json();
                if (result.success) {
                    closeEditModal();
                    location.reload();
                } else {
                    alert('Failed to update key: ' + (result.error || 'Unknown error'));
                }
            } catch(e) {
                alert('Error: ' + e.message);
            }
        });

        // ============ KEY ACTIONS ============
        async function toggleKeyStatus(id, currentStatus) {
            const newStatus = currentStatus === 'active' ? 'disabled' : 'active';
            if (!confirm(`Set key to ${newStatus}?`)) return;
            
            try {
                const response = await fetch('/admin/toggle-status', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                    body: `id=${id}&status=${newStatus}`
                });
                location.reload();
            } catch(e) {
                alert('Error: ' + e.message);
            }
        }

        async function deleteKey(id) {
            if (!confirm('Are you sure you want to delete this key?')) return;
            try {
                const response = await fetch('/admin/delete-key', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                    body: `id=${id}`
                });
                location.reload();
            } catch(e) {
                alert('Error: ' + e.message);
            }
        }

        // ============ COUNTDOWN TIMERS ============
        function updateTimers() {
            const keyCards = document.querySelectorAll('.key-card[data-expires]');
            const now = new Date();
            
            keyCards.forEach(card => {
                const expiresAt = card.dataset.expires;
                if (!expiresAt) return;
                
                const expiry = new Date(expiresAt);
                const diff = expiry - now;
                const timerEl = card.querySelector('.timer');
                
                if (diff <= 0) {
                    timerEl.textContent = '🔴 EXPIRED';
                    timerEl.className = 'timer expired';
                    const badge = card.querySelector('.status-badge');
                    if (badge) {
                        badge.textContent = 'EXPIRED';
                        badge.className = 'status-badge expired';
                    }
                    return;
                }
                
                const days = Math.floor(diff / (1000 * 60 * 60 * 24));
                const hours = Math.floor((diff % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60));
                const minutes = Math.floor((diff % (1000 * 60 * 60)) / (1000 * 60));
                const seconds = Math.floor((diff % (1000 * 60)) / 1000);
                
                let timerText = '';
                if (days > 0) timerText += `${days}d `;
                if (hours > 0 || days > 0) timerText += `${hours}h `;
                timerText += `${minutes}m ${seconds}s`;
                
                timerEl.textContent = `⏳ ${timerText}`;
                timerEl.className = 'timer';
            });
        }

        // Update timers every second
        setInterval(updateTimers, 1000);
        updateTimers();

        // ============ KEYBOARD SHORTCUTS ============
        document.addEventListener('keydown', (e) => {
            if (e.key === 'Escape') closeEditModal();
        });

        // Close modal on outside click
        document.getElementById('editModal').addEventListener('click', function(e) {
            if (e.target === this) closeEditModal();
        });

        // Reduce motion preference
        const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        if (prefersReducedMotion) {
            document.documentElement.style.setProperty('--transition-duration', '0s');
        }
    </script>
</body>
</html>
