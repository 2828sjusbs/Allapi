<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Head Admin Dashboard - OSINT API Hub</title>
    <style>
        /* Same styles as dashboard.ejs, plus additional for admin management */
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }
        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background: #0a0e1a;
            color: #e0e0e0;
            min-height: 100vh;
        }
        .container {
            max-width: 1400px;
            margin: 0 auto;
            padding: 20px;
        }
        .header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 15px 0;
            border-bottom: 1px solid #1e2a3a;
            margin-bottom: 30px;
            flex-wrap: wrap;
            gap: 10px;
        }
        .header h1 {
            font-size: 24px;
            background: linear-gradient(135deg, #ff6b6b, #ffd93d);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }
        .user-info {
            display: flex;
            align-items: center;
            gap: 15px;
            flex-wrap: wrap;
        }
        .user-info .badge {
            background: #1e2a3a;
            padding: 5px 15px;
            border-radius: 20px;
            font-size: 12px;
            color: #ffd93d;
        }
        .btn-logout {
            background: #ff4444;
            color: white;
            border: none;
            padding: 8px 20px;
            border-radius: 5px;
            cursor: pointer;
            font-weight: bold;
        }
        .btn-logout:hover {
            background: #cc0000;
        }
        .stats-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
            gap: 20px;
            margin-bottom: 30px;
        }
        .stat-card {
            background: #141e2b;
            padding: 20px;
            border-radius: 12px;
            border: 1px solid #1e2a3a;
        }
        .stat-card .number {
            font-size: 32px;
            font-weight: bold;
            background: linear-gradient(135deg, #ff6b6b, #ffd93d);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }
        .stat-card .label {
            font-size: 14px;
            color: #8899aa;
            margin-top: 5px;
        }

        .admin-section {
            background: #141e2b;
            border-radius: 12px;
            padding: 20px;
            border: 1px solid #1e2a3a;
            margin-bottom: 30px;
        }
        .admin-section h2 {
            color: #ffd93d;
            margin-bottom: 15px;
        }
        .admin-list {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
            gap: 15px;
        }
        .admin-item {
            display: flex;
            justify-content: space-between;
            align-items: center;
            background: #0a0e1a;
            padding: 12px 18px;
            border-radius: 8px;
            border: 1px solid #1e2a3a;
        }
        .admin-item .admin-info {
            display: flex;
            flex-direction: column;
        }
        .admin-item .admin-username {
            font-weight: bold;
            color: #e0e0e0;
        }
        .admin-item .admin-role {
            font-size: 12px;
            color: #ffd93d;
        }
        .admin-item .admin-created {
            font-size: 11px;
            color: #8899aa;
        }
        .admin-item .btn-remove {
            background: #dc3545;
            color: white;
            border: none;
            padding: 5px 15px;
            border-radius: 5px;
            cursor: pointer;
            font-size: 12px;
        }
        .admin-item .btn-remove:hover {
            background: #a71d2a;
        }

        .form-inline {
            display: flex;
            gap: 10px;
            flex-wrap: wrap;
            margin-top: 15px;
        }
        .form-inline input, .form-inline select {
            padding: 10px;
            background: #0a0e1a;
            border: 1px solid #1e2a3a;
            border-radius: 6px;
            color: #e0e0e0;
            flex: 1;
            min-width: 150px;
        }
        .form-inline button {
            padding: 10px 20px;
            background: linear-gradient(135deg, #ff6b6b, #ffd93d);
            color: white;
            border: none;
            border-radius: 6px;
            cursor: pointer;
            font-weight: bold;
        }
        .form-inline button:hover {
            opacity: 0.8;
        }

        /* Copy from dashboard.ejs for key cards */
        .key-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(400px, 1fr));
            gap: 20px;
            margin-top: 20px;
        }
        .key-card {
            background: #141e2b;
            border-radius: 12px;
            padding: 20px;
            border: 1px solid #1e2a3a;
            position: relative;
            transition: 0.3s;
        }
        .key-card:hover {
            border-color: #ffd93d;
            transform: translateY(-2px);
        }
        .key-card .key-name {
            font-size: 18px;
            font-weight: bold;
            color: #ffd93d;
        }
        .key-card .key-value {
            font-family: monospace;
            background: #0a0e1a;
            padding: 5px 10px;
            border-radius: 4px;
            margin: 5px 0 10px;
            font-size: 13px;
            word-break: break-all;
            color: #7bff9e;
        }
        .key-card .status-badge {
            display: inline-block;
            padding: 3px 12px;
            border-radius: 20px;
            font-size: 11px;
            font-weight: bold;
        }
        .status-badge.active {
            background: #00d4ff22;
            color: #00d4ff;
            border: 1px solid #00d4ff44;
        }
        .status-badge.disabled {
            background: #ff444422;
            color: #ff4444;
            border: 1px solid #ff444444;
        }
        .status-badge.expired {
            background: #ff880022;
            color: #ff8800;
            border: 1px solid #ff880044;
        }
        .key-card .info-row {
            display: flex;
            justify-content: space-between;
            padding: 5px 0;
            font-size: 13px;
            border-bottom: 1px solid #1e2a3a33;
        }
        .key-card .info-row .label {
            color: #8899aa;
        }
        .key-card .info-row .value {
            color: #e0e0e0;
        }
        .key-card .timer {
            font-family: monospace;
            font-size: 16px;
            font-weight: bold;
            color: #ffd93d;
            padding: 8px;
            background: #0a0e1a;
            border-radius: 8px;
            text-align: center;
            margin: 10px 0;
        }
        .key-card .timer.expired {
            color: #ff4444;
        }
        .key-card .badges {
            display: flex;
            gap: 8px;
            flex-wrap: wrap;
            margin: 8px 0;
        }
        .key-card .badge-item {
            padding: 2px 10px;
            border-radius: 12px;
            font-size: 11px;
            font-weight: bold;
        }
        .badge-item.unlimited {
            background: #7bff9e22;
            color: #7bff9e;
            border: 1px solid #7bff9e44;
        }
        .badge-item.note {
            background: #ffbb0022;
            color: #ffbb00;
            border: 1px solid #ffbb0044;
        }
        .key-card .actions {
            display: flex;
            gap: 8px;
            margin-top: 12px;
            flex-wrap: wrap;
        }
        .key-card .actions button {
            padding: 5px 15px;
            border: none;
            border-radius: 5px;
            cursor: pointer;
            font-size: 12px;
            font-weight: bold;
            transition: 0.3s;
        }
        .btn-edit {
            background: #007bff;
            color: white;
        }
        .btn-edit:hover {
            background: #0056b3;
        }
        .btn-delete {
            background: #dc3545;
            color: white;
        }
        .btn-delete:hover {
            background: #a71d2a;
        }
        .btn-toggle {
            background: #6c757d;
            color: white;
        }
        .btn-toggle:hover {
            background: #5a6268;
        }
        .btn-toggle.active-btn {
            background: #28a745;
        }
        .btn-toggle.active-btn:hover {
            background: #1e7e34;
        }

        /* Master API Card - same as dashboard */
        .master-api-card {
            background: #141e2b;
            border-radius: 12px;
            padding: 25px;
            border: 1px solid #1e2a3a;
            margin-bottom: 30px;
        }
        .master-api-card .card-title {
            font-size: 20px;
            font-weight: bold;
            margin-bottom: 15px;
            color: #ffd93d;
        }
        .master-api-card .toggle-row {
            display: flex;
            align-items: center;
            gap: 20px;
            margin-bottom: 15px;
            flex-wrap: wrap;
        }
        .toggle-switch {
            position: relative;
            width: 60px;
            height: 30px;
            background: #1e2a3a;
            border-radius: 15px;
            cursor: pointer;
            transition: 0.3s;
        }
        .toggle-switch.active {
            background: #ffd93d;
        }
        .toggle-switch .slider {
            position: absolute;
            top: 3px;
            left: 3px;
            width: 24px;
            height: 24px;
            background: white;
            border-radius: 50%;
            transition: 0.3s;
        }
        .toggle-switch.active .slider {
            left: 33px;
        }
        .toggle-status {
            font-weight: bold;
            font-size: 16px;
        }
        .toggle-status.on {
            color: #ffd93d;
        }
        .toggle-status.off {
            color: #ff4444;
        }
        .master-api-card textarea {
            width: 100%;
            padding: 12px;
            background: #0a0e1a;
            border: 1px solid #1e2a3a;
            border-radius: 8px;
            color: #e0e0e0;
            font-size: 14px;
            resize: vertical;
            min-height: 60px;
            margin-bottom: 15px;
        }
        .master-api-card .btn-save {
            background: linear-gradient(135deg, #ff6b6b, #ffd93d);
            color: white;
            border: none;
            padding: 10px 30px;
            border-radius: 8px;
            cursor: pointer;
            font-weight: bold;
            transition: 0.3s;
        }
        .master-api-card .btn-save:hover {
            opacity: 0.8;
            transform: scale(1.02);
        }

        @media (max-width: 768px) {
            .key-grid {
                grid-template-columns: 1fr;
            }
            .header {
                flex-direction: column;
                text-align: center;
            }
            .form-inline {
                flex-direction: column;
            }
            .form-inline input, .form-inline select, .form-inline button {
                width: 100%;
            }
        }
    </style>
</head>
<body>
    <div class="container">
        <div class="header">
            <h1>👑 OSINT API Hub — Head Admin</h1>
            <div class="user-info">
                <span class="badge">👤 <%= user.username %> (<%= user.role %>)</span>
                <a href="/logout" class="btn-logout">Logout</a>
            </div>
        </div>

        <!-- Stats -->
        <div class="stats-grid">
            <div class="stat-card">
                <div class="number"><%= keys.length %></div>
                <div class="label">Total API Keys</div>
            </div>
            <div class="stat-card">
                <div class="number"><%= totalHits %></div>
                <div class="label">Total Hits</div>
            </div>
            <div class="stat-card">
                <div class="number"><%= admins.length %></div>
                <div class="label">Admin Users</div>
            </div>
        </div>

        <!-- Master API Card -->
        <div class="master-api-card" id="masterApiCard">
            <div class="card-title">🌐 API SYSTEM</div>
            <div class="toggle-row">
                <div class="toggle-switch <%= settings && settings.master_api == 1 ? 'active' : '' %>" 
                     id="masterToggle" onclick="toggleMasterApi()">
                    <div class="slider"></div>
                </div>
                <span class="toggle-status <%= settings && settings.master_api == 1 ? 'on' : 'off' %>" id="masterStatus">
                    <%= settings && settings.master_api == 1 ? '🟢 ONLINE' : '🔴 OFFLINE' %>
                </span>
            </div>
            <textarea id="maintenanceMessage" placeholder="Maintenance message..."><%= settings && settings.maintenance_message ? settings.maintenance_message : 'API is currently under maintenance.' %></textarea>
            <button class="btn-save" onclick="saveMasterSettings()">💾 Save Settings</button>
            <div id="masterSaveStatus" style="margin-top:10px;font-size:13px;color:#7bff9e;"></div>
        </div>

        <!-- Admin Management -->
        <div class="admin-section">
            <h2>👥 Admin Management</h2>
            <div class="admin-list">
                <% if (admins && admins.length > 0) { %>
                    <% admins.forEach(admin => { %>
                        <div class="admin-item">
                            <div class="admin-info">
                                <span class="admin-username"><%= admin.username %></span>
                                <span class="admin-role"><%= admin.role || 'admin' %></span>
                                <span class="admin-created">Created: <%= admin.created_at ? new Date(admin.created_at).toLocaleString() : 'N/A' %></span>
                            </div>
                            <button class="btn-remove" onclick="removeAdmin(<%= admin.id %>)">Remove</button>
                        </div>
                    }); %>
                <% } else { %>
                    <p style="color:#8899aa;">No admin users found.</p>
                <% } %>
            </div>
            <form class="form-inline" onsubmit="createAdmin(event)">
                <input type="text" name="username" placeholder="Username" required>
                <input type="password" name="password" placeholder="Password" required>
                <select name="role">
                    <option value="admin">Admin</option>
                    <option value="head_admin">Head Admin</option>
                </select>
                <button type="submit">➕ Add Admin</button>
            </form>
            <div id="adminStatus" style="margin-top:10px;font-size:13px;"></div>
        </div>

        <!-- Key Cards -->
        <h2 style="color:#ffd93d;margin:20px 0;">🔑 API Keys</h2>
        <div class="key-grid" id="keyGrid">
            <% if (keys && keys.length > 0) { %>
                <% keys.forEach(key => { 
                    const isExpired = key.expires_at && new Date(key.expires_at) < new Date();
                    const status = isExpired ? 'expired' : (key.status || 'active');
                    let allowedApis = [];
                    try { allowedApis = JSON.parse(key.allowed_apis || '["all"]'); } catch(e) { allowedApis = ['all']; }
                %>
                    <div class="key-card" id="key-<%= key.id %>" data-expires="<%= key.expires_at %>">
                        <div class="key-name"><%= key.name || 'Unnamed' %></div>
                        <div class="key-value"><%= key.key %></div>
                        <div>
                            <span class="status-badge <%= status %>"><%= status.toUpperCase() %></span>
                        </div>
                        <div class="info-row">
                            <span class="label">Created</span>
                            <span class="value"><%= key.created_at ? new Date(key.created_at).toLocaleString() : 'N/A' %></span>
                        </div>
                        <div class="info-row">
                            <span class="label">Expires</span>
                            <span class="value"><%= key.expires_at ? new Date(key.expires_at).toLocaleString() : 'Never' %></span>
                        </div>
                        <div class="timer" id="timer-<%= key.id %>">
                            <%= key.expires_at ? 'Loading...' : '🔵 Never Expires' %>
                        </div>
                        <div class="badges">
                            <% if (key.unlimited_hits == 1) { %>
                                <span class="badge-item unlimited">🚀 Unlimited</span>
                            <% } %>
                            <% if (key.note_enabled == 1 && key.key_note) { %>
                                <span class="badge-item note">📝 <%= key.key_note %></span>
                            <% } %>
                            <span class="badge-item" style="background:#1e2a3a;color:#8899aa;">
                                APIs: <%= allowedApis.includes('all') ? 'All' : allowedApis.length %>
                            </span>
                        </div>
                        <div class="actions">
                            <button class="btn-toggle <%= status === 'active' ? 'active-btn' : '' %>" onclick="toggleKeyStatus(<%= key.id %>, '<%= status %>')">
                                <%= status === 'active' ? '✅ Active' : '🔴 Disable' %>
                            </button>
                            <button class="btn-delete" onclick="deleteKey(<%= key.id %>)">🗑️ Delete</button>
                        </div>
                    </div>
                <% }); %>
            <% } else { %>
                <p style="color:#8899aa;text-align:center;padding:40px;">No API keys generated yet.</p>
            <% } %>
        </div>
    </div>

    <script>
        // ============ MASTER API TOGGLE ============
        function toggleMasterApi() {
            const toggle = document.getElementById('masterToggle');
            const status = document.getElementById('masterStatus');
            const isActive = toggle.classList.toggle('active');
            status.textContent = isActive ? '🟢 ONLINE' : '🔴 OFFLINE';
            status.className = 'toggle-status ' + (isActive ? 'on' : 'off');
        }

        async function saveMasterSettings() {
            const toggle = document.getElementById('masterToggle');
            const message = document.getElementById('maintenanceMessage').value;
            const masterApi = toggle.classList.contains('active') ? 'on' : 'off';
            
            const statusDiv = document.getElementById('masterSaveStatus');
            statusDiv.textContent = '⏳ Saving...';
            
            try {
                const response = await fetch('/admin/update-settings', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ master_api: masterApi, maintenance_message: message })
                });
                const data = await response.json();
                if (data.success) {
                    statusDiv.textContent = '✅ Settings saved successfully!';
                    statusDiv.style.color = '#7bff9e';
                } else {
                    statusDiv.textContent = '❌ Failed to save settings';
                    statusDiv.style.color = '#ff4444';
                }
            } catch(e) {
                statusDiv.textContent = '❌ Error: ' + e.message;
                statusDiv.style.color = '#ff4444';
            }
        }

        // ============ ADMIN MANAGEMENT ============
        async function createAdmin(e) {
            e.preventDefault();
            const form = e.target;
            const formData = new FormData(form);
            const data = {};
            formData.forEach((value, key) => data[key] = value);
            
            const statusDiv = document.getElementById('adminStatus');
            statusDiv.textContent = '⏳ Creating admin...';
            
            try {
                const response = await fetch('/head-admin/create-admin', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(data)
                });
                const result = await response.json();
                if (result.success) {
                    statusDiv.textContent = '✅ Admin created successfully!';
                    statusDiv.style.color = '#7bff9e';
                    setTimeout(() => location.reload(), 1000);
                } else {
                    statusDiv.textContent = '❌ ' + (result.error || 'Failed to create admin');
                    statusDiv.style.color = '#ff4444';
                }
            } catch(e) {
                statusDiv.textContent = '❌ Error: ' + e.message;
                statusDiv.style.color = '#ff4444';
            }
        }

        async function removeAdmin(id) {
            if (!confirm('Remove this admin user?')) return;
            try {
                const response = await fetch('/head-admin/remove-admin', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ admin_id: id })
                });
                const result = await response.json();
                if (result.success) {
                    location.reload();
                } else {
                    alert('Failed to remove admin: ' + (result.error || 'Unknown error'));
                }
            } catch(e) {
                alert('Error: ' + e.message);
            }
        }

        // ============ KEY ACTIONS ============
        async function toggleKeyStatus(id, currentStatus) {
            const newStatus = currentStatus === 'active' ? 'disabled' : 'active';
            if (!confirm(`Set key to ${newStatus}?`)) return;
            
            try {
                const response = await fetch('/admin/toggle-status', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                    body: `id=${id}&status=${newStatus}`
                });
                location.reload();
            } catch(e) {
                alert('Error: ' + e.message);
            }
        }

        async function deleteKey(id) {
            if (!confirm('Are you sure you want to delete this key?')) return;
            try {
                const response = await fetch('/admin/delete-key', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                    body: `id=${id}`
                });
                location.reload();
            } catch(e) {
                alert('Error: ' + e.message);
            }
        }

        // ============ COUNTDOWN TIMERS ============
        function updateTimers() {
            const keyCards = document.querySelectorAll('.key-card[data-expires]');
            const now = new Date();
            
            keyCards.forEach(card => {
                const expiresAt = card.dataset.expires;
                if (!expiresAt) return;
                
                const expiry = new Date(expiresAt);
                const diff = expiry - now;
                const timerEl = card.querySelector('.timer');
                
                if (diff <= 0) {
                    timerEl.textContent = '🔴 EXPIRED';
                    timerEl.className = 'timer expired';
                    const badge = card.querySelector('.status-badge');
                    if (badge) {
                        badge.textContent = 'EXPIRED';
                        badge.className = 'status-badge expired';
                    }
                    return;
                }
                
                const days = Math.floor(diff / (1000 * 60 * 60 * 24));
                const hours = Math.floor((diff % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60));
                const minutes = Math.floor((diff % (1000 * 60 * 60)) / (1000 * 60));
                const seconds = Math.floor((diff % (1000 * 60)) / 1000);
                
                let timerText = '';
                if (days > 0) timerText += `${days}d `;
                if (hours > 0 || days > 0) timerText += `${hours}h `;
                timerText += `${minutes}m ${seconds}s`;
                
                timerEl.textContent = `⏳ ${timerText}`;
                timerEl.className = 'timer';
            });
        }

        setInterval(updateTimers, 1000);
        updateTimers();
    </script>
</body>
</html>
