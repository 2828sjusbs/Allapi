<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Login — OSINT API Hub</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;600;700;800&family=JetBrains+Mono:wght@400;700&display=swap" rel="stylesheet">
  <style>
    body { background:#060a10; font-family:'Plus Jakarta Sans',sans-serif; }
    .glass { background:rgba(255,255,255,0.03); backdrop-filter:blur(24px); border:1px solid rgba(255,255,255,0.07); }
    .grid-bg {
      background-image: linear-gradient(rgba(6,182,212,0.03) 1px,transparent 1px),
                        linear-gradient(90deg,rgba(6,182,212,0.03) 1px,transparent 1px);
      background-size:40px 40px;
    }
    @keyframes float{0%,100%{transform:translateY(0) scale(1);}50%{transform:translateY(-20px) scale(1.05);}}
    @keyframes scanline{0%{top:-5%;}100%{top:105%;}}
    .orb{animation:float 8s ease-in-out infinite;}
    .orb2{animation:float 10s ease-in-out infinite reverse;}
    .scanline{animation:scanline 4s linear infinite;}
    input:-webkit-autofill{-webkit-box-shadow:0 0 0 30px #0d1420 inset !important;-webkit-text-fill-color:#e2e8f0 !important;}
  </style>
</head>
<body class="min-h-screen flex items-center justify-center grid-bg relative overflow-hidden">
  <div class="orb absolute top-[-80px] left-[-80px] w-[400px] h-[400px] rounded-full bg-cyan-500/10 blur-3xl pointer-events-none"></div>
  <div class="orb2 absolute bottom-[-80px] right-[-80px] w-[350px] h-[350px] rounded-full bg-indigo-600/10 blur-3xl pointer-events-none"></div>
  <div class="scanline absolute left-0 w-full h-[2px] bg-gradient-to-r from-transparent via-cyan-400/20 to-transparent pointer-events-none"></div>

  <div class="relative z-10 w-full max-w-md px-4">
    <div class="text-center mb-8">
      <div class="inline-flex h-16 w-16 rounded-2xl bg-gradient-to-br from-cyan-500 to-indigo-600 items-center justify-center shadow-2xl shadow-cyan-500/30 mb-4">
        <i class="fa-solid fa-terminal text-white text-2xl"></i>
      </div>
      <h1 class="text-2xl font-extrabold text-white tracking-tight">OSINT <span class="text-cyan-400">HUB</span></h1>
      <p class="text-xs text-gray-500 font-mono mt-1 uppercase tracking-widest">Secure Admin Portal</p>
    </div>

    <div class="glass rounded-3xl p-8" style="box-shadow:0 0 40px rgba(6,182,212,0.15),0 0 80px rgba(6,182,212,0.05)">
      <h2 class="text-lg font-bold text-white mb-1">Welcome back</h2>
      <p class="text-xs text-gray-500 mb-6">Sign in to your admin account</p>

      <% if (error) { %>
      <div class="flex items-center gap-3 bg-red-500/10 border border-red-500/25 rounded-xl px-4 py-3 mb-5">
        <i class="fa-solid fa-triangle-exclamation text-red-400 text-sm"></i>
        <span class="text-sm text-red-300">
          <% if (error === 'invalid') { %>Invalid username or password
          <% } else if (error === 'missing') { %>Please enter both fields
          <% } else { %>Login failed. Try again<% } %>
        </span>
      </div>
      <% } %>

      <form method="POST" action="/login" class="space-y-4">
        <div>
          <label class="block text-xs font-semibold text-gray-400 mb-1.5 uppercase tracking-wider">Username</label>
          <div class="relative">
            <i class="fa-solid fa-user absolute left-3.5 top-1/2 -translate-y-1/2 text-gray-600 text-xs"></i>
            <input type="text" name="username" required autofocus placeholder="Enter username"
              class="w-full bg-[#0d1420] border border-gray-800 focus:border-cyan-500/60 focus:ring-2 focus:ring-cyan-500/10 rounded-xl pl-10 pr-4 py-3 text-sm text-gray-200 placeholder-gray-600 outline-none transition">
          </div>
        </div>
        <div>
          <label class="block text-xs font-semibold text-gray-400 mb-1.5 uppercase tracking-wider">Password</label>
          <div class="relative">
            <i class="fa-solid fa-lock absolute left-3.5 top-1/2 -translate-y-1/2 text-gray-600 text-xs"></i>
            <input type="password" name="password" id="pwdInput" required placeholder="Enter password"
              class="w-full bg-[#0d1420] border border-gray-800 focus:border-cyan-500/60 focus:ring-2 focus:ring-cyan-500/10 rounded-xl pl-10 pr-10 py-3 text-sm text-gray-200 placeholder-gray-600 outline-none transition">
            <button type="button" onclick="togglePwd()" class="absolute right-3.5 top-1/2 -translate-y-1/2 text-gray-600 hover:text-gray-300 transition">
              <i class="fa-solid fa-eye text-xs" id="pwdIcon"></i>
            </button>
          </div>
        </div>
        <button type="submit"
          class="w-full mt-2 py-3 bg-gradient-to-r from-cyan-500 to-indigo-600 hover:from-cyan-400 hover:to-indigo-500 text-white font-bold rounded-xl text-sm transition shadow-lg shadow-cyan-500/20 flex items-center justify-center gap-2">
          <i class="fa-solid fa-right-to-bracket"></i> Sign In
        </button>
      </form>

      <div class="mt-6 pt-5 border-t border-white/5 text-center">
        <a href="/" class="text-xs text-gray-600 hover:text-gray-400 transition inline-flex items-center gap-1.5">
          <i class="fa-solid fa-arrow-left text-[10px]"></i> Back to Home
        </a>
      </div>
    </div>
  </div>
  <script>
    function togglePwd(){
      const i=document.getElementById('pwdInput'),ic=document.getElementById('pwdIcon');
      if(i.type==='password'){i.type='text';ic.className='fa-solid fa-eye-slash text-xs';}
      else{i.type='password';ic.className='fa-solid fa-eye text-xs';}
    }
  </script>
</body>
</html>
